---
import data from '../data/pricing.json';
import type { Lang } from '../data/site';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const L = lang;
// Ambil field berbahasa: f('lead') -> data.lead_id / data.lead_en
const f = (k: string) => (data as Record<string, any>)[`${k}_${L}`];
const wa = (text: string) => `https://wa.me/6285927277560?text=${encodeURIComponent(text)}`;
const pagePath = lang === 'id' ? '/harga' : '/en/pricing';
---

<main id="page-pricing" class="page">
  <section class="hero wrap">
    <div class="shead reveal">
      <div class="label"><span class="eyebrow">{f('eyebrow')}</span><span class="folio">01</span></div>
    </div>
    <h1 class="h1 reveal d1" style="max-width:18ch;margin-top:18px">{f('h1_lead')} <span class="u-accent">{f('h1_accent')}</span></h1>
    <p class="lead reveal d2" style="margin-top:22px">{f('lead')}</p>
  </section>
  <hr class="hair" style="margin:0 var(--gut)">

  <section class="pad-sm wrap">
    <div class="shead reveal">
      <div class="label">
        <div>
          <span class="eyebrow">{f('packagesEyebrow')}</span>
          <h2 class="h2" style="margin-top:18px;max-width:20ch">{f('packagesTitle')}</h2>
        </div>
        <span class="folio">02</span>
      </div>
    </div>
    <div class="price-grid">
      {data.packages.map((p: any) => (
        <div class={p.featured ? 'price-card is-featured' : 'price-card'}>
          {p[`badge_${L}`] && <span class="pc-badge">{p[`badge_${L}`]}</span>}
          <span class="pc-name">{p[`name_${L}`]}</span>
          <span class="pc-price">{p[`price_${L}`]}</span>
          <span class="pc-meta">{p[`meta_${L}`]}</span>
          <ul class="pc-items">
            {p[`features_${L}`].map((it: string) => <li>{it}</li>)}
          </ul>
          <a href={wa(p[`wa_${L}`])} class={p.featured ? 'btn on-ink' : 'btn'} target="_blank" rel="noopener" data-wa={`pricing-${p.key}`} data-page={pagePath}>
            {p[`cta_${L}`]}<span class="arr">↗</span>
          </a>
        </div>
      ))}
    </div>
    <p class="lead reveal" style="margin-top:26px;font-size:15px;color:var(--ink-soft);max-width:70ch">{f('packagesNote')}</p>
  </section>
  <hr class="hair" style="margin:0 var(--gut)">

  <section class="pad-sm wrap">
    <div class="shead reveal">
      <div class="label">
        <div>
          <span class="eyebrow">{f('factorsEyebrow')}</span>
          <h2 class="h2" style="margin-top:18px;max-width:22ch">{f('factorsTitle')}</h2>
          <p class="lead" style="margin-top:16px;max-width:62ch">{f('factorsLead')}</p>
        </div>
        <span class="folio">03</span>
      </div>
    </div>
    <div class="deflist reveal">
      {data.factors.map((x: any) => (
        <div><b>{x[`title_${L}`]}</b><p>{x[`desc_${L}`]}</p></div>
      ))}
    </div>
  </section>

  <section class="pad-sm wrap">
    <div class="shead reveal">
      <div class="label">
        <div>
          <span class="eyebrow">{f('notIncludedEyebrow')}</span>
          <h2 class="h2" style="margin-top:18px;max-width:22ch">{f('notIncludedTitle')}</h2>
          <p class="lead" style="margin-top:16px;max-width:62ch">{f('notIncludedLead')}</p>
        </div>
        <span class="folio">04</span>
      </div>
    </div>
    <div class="deflist reveal">
      {data.notIncluded.map((x: any) => (
        <div><b>{x[`title_${L}`]}</b><p>{x[`desc_${L}`]}</p></div>
      ))}
    </div>
  </section>
  <hr class="hair" style="margin:0 var(--gut)">

  <section class="pad-sm wrap">
    <div class="shead reveal">
      <div class="label">
        <div>
          <span class="eyebrow">{f('faqEyebrow')}</span>
          <h2 class="h2" style="margin-top:18px">{f('faqTitle')}</h2>
        </div>
        <span class="folio">05</span>
      </div>
    </div>
    <div class="faq reveal">
      {data.faq.map((q: any, i: number) => (
        <details>
          <summary><span class="fq">/{String(i + 1).padStart(2, '0')}</span>{q[`q_${L}`]}</summary>
          <p class="fa">{q[`a_${L}`]}</p>
        </details>
      ))}
    </div>
  </section>

  <div class="marquee accent" aria-hidden="true">
    <div class="marquee-track">
      {lang === 'id' ? (
        <>
          <span>Strategi</span><span>Desain</span><span>Pengembangan</span><span>Konsultasi</span><span>Problem Solving</span><span>User Experience</span><span>Produk Digital</span>
          <span>Strategi</span><span>Desain</span><span>Pengembangan</span><span>Konsultasi</span><span>Problem Solving</span><span>User Experience</span><span>Produk Digital</span>
        </>
      ) : (
        <>
          <span>Strategy</span><span>Design</span><span>Development</span><span>Consulting</span><span>Problem Solving</span><span>User Experience</span><span>Digital Products</span>
          <span>Strategy</span><span>Design</span><span>Development</span><span>Consulting</span><span>Problem Solving</span><span>User Experience</span><span>Digital Products</span>
        </>
      )}
    </div>
  </div>

  <section class="cta-ink pad">
    <img class="bgimg" src="/img/cta-bg.webp" width="1440" height="1024" loading="lazy" decoding="async" alt="" aria-hidden="true" />
    <div class="wrap" style="position:relative">
      <span class="eyebrow reveal">{lang === 'id' ? '// Mari Bicara' : "// Let's talk"}</span>
      <h2 class="h2 reveal d1" style="margin:24px 0 36px">{f('ctaTitle')}</h2>
      <div class="reveal d2">
        <a href={wa(f('ctaWa'))} class="btn on-ink" target="_blank" rel="noopener" data-wa="cta" data-page={pagePath}>
          {lang === 'id' ? 'Konsultasi Gratis' : 'Free Consultation'}<span class="arr">↗</span>
        </a>
      </div>
    </div>
  </section>
</main>
