---
import Base from '../layouts/Base.astro';
import PricingBody from '../components/PricingBody.astro';
import pricing from '../data/pricing.json';
import seo from '../data/seo/pricing.json';

const extraSchema = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://mglportfolio.vercel.app/' },
      { '@type': 'ListItem', position: 2, name: 'Harga', item: 'https://mglportfolio.vercel.app/harga' },
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: pricing.faq.map((q) => ({
      '@type': 'Question',
      name: q.q_id,
      acceptedAnswer: { '@type': 'Answer', text: q.a_id },
    })),
  },
];
---

<Base
  lang="id"
  title={seo.title_id}
  description={seo.desc_id}
  image={seo.ogImage}
  idPath="/harga"
  enPath="/en/pricing"
  extraSchema={extraSchema}
>
  <PricingBody lang="id" />
</Base>
