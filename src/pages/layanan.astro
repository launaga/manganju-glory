---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import seo from '../data/seo/services.json';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const waHero = "https://wa.me/6285927277560?text=Hi!%20Saya%20ingin%20diskusi%20layanan%20mana%20yang%20cocok%20untuk%20kebutuhan%20saya...";

const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://mglportfolio.vercel.app/' },
    { '@type': 'ListItem', position: 2, name: 'Layanan', item: 'https://mglportfolio.vercel.app/layanan' },
  ],
};
---

<Base
  lang="id"
  title={seo.title_id}
  description={seo.desc_id}
  image={seo.ogImage}
  idPath="/layanan"
  enPath="/en/services"
  extraSchema={[breadcrumb]}
>
  <main id="page-layanan" class="page">
    <section class="hero wrap">
      <div class="shead reveal">
        <div class="label"><span class="eyebrow">// Layanan</span><span class="folio">01</span></div>
      </div>
      <h1 class="h1 reveal d1" style="max-width:16ch;margin-top:18px">Jasa pembuatan website, <span class="u-accent">dimulai dari strategi.</span></h1>
      <p class="lead reveal d2" style="margin-top:22px">Lima cara saya bekerja dengan bisnis dan organisasi. Semuanya berangkat dari tempat yang sama — memahami masalahnya dulu — dan berbeda hanya pada seberapa jauh saya ikut mengeksekusi.</p>
      <div class="reveal d3" style="margin-top:32px;display:flex;gap:14px;flex-wrap:wrap">
        <a href={waHero} class="btn" target="_blank" rel="noopener" data-wa="hero" data-page="/layanan">Konsultasi Gratis<span class="arr">↗</span></a>
        <a href="/kontak" class="btn ghost">Hubungi saya <span class="arr">↗</span></a>
      </div>
    </section>
    <hr class="hair" style="margin:0 var(--gut)">

    <section class="pad-sm wrap">
      <div class="shead reveal">
        <div class="label">
          <div>
            <span class="eyebrow">// 02 — Pilihan</span>
            <h2 class="h2" style="margin-top:18px;max-width:20ch">Pilih berdasarkan masalahnya, bukan namanya.</h2>
            <p class="lead" style="margin-top:16px;max-width:62ch">Kalau ragu yang mana, ambil sesi konsultasi gratis dan biarkan saya bantu memilihkan. Termasuk kemungkinan saya menyarankan Anda belum butuh satu pun dari ini.</p>
          </div>
          <span class="folio">02</span>
        </div>
      </div>
      <div class="svc-hub">
        {services.map((s) => (
          <a class="svc-hub-card" href={`/layanan/${s.data.slug_id}`}>
            <span class="n">{s.data.n_id}</span>
            <h3>{s.data.h_id}</h3>
            <p>{s.data.p_id}</p>
            <span class="meta">{s.data.meta_id}</span>
            <span class="open">Selengkapnya ↗</span>
          </a>
        ))}
      </div>
    </section>
    <hr class="hair" style="margin:0 var(--gut)">

    <section class="pad-sm wrap">
      <div class="shead reveal">
        <div class="label">
          <div>
            <span class="eyebrow">// 03 — Cara kerja</span>
            <h2 class="h2" style="margin-top:18px">Satu proses, apa pun layanannya.</h2>
            <p class="lead" style="margin-top:18px;max-width:62ch">Setiap proyek melalui tahapan yang sama. Anda akan selalu tahu kita sedang di mana, apa langkah berikutnya, dan apa yang perlu Anda siapkan.</p>
          </div>
          <span class="folio">03</span>
        </div>
      </div>
      <div class="proc">
        <div class="proc-step reveal"><div class="pn">1.</div><h3>Discovery &amp; Diagnosis</h3><p>Memahami bisnis, tantangan, dan peluangnya. Yang Anda dapat: ruang lingkup yang jelas, linimasa, dan penilaian jujur tentang apa yang realistis.</p></div>
        <div class="proc-step reveal d1"><div class="pn">2.</div><h3>Desain &amp; Pengembangan</h3><p>Merancang dan membangun solusinya. Yang Anda dapat: update rutin, ruang untuk masukan, dan tanpa kejutan saat peluncuran.</p></div>
        <div class="proc-step reveal d2"><div class="pn">3.</div><h3>Peluncuran &amp; Pertumbuhan</h3><p>Mendukung keberhasilan jangka panjang setelah peluncuran. Yang Anda dapat: situs yang bekerja di hari pertama, dan rencana untuk hari keseratus.</p></div>
        <div class="proc-step reveal d3"><div class="pn">4.</div><h3>Transparansi Linimasa</h3><p>Proyek umumnya berjalan 4–12 minggu tergantung kompleksitas. Tanpa misteri, tanpa target yang bergeser.</p></div>
      </div>
    </section>

    <div class="marquee accent" aria-hidden="true">
      <div class="marquee-track">
        <span>Strategi</span><span>Desain</span><span>Pengembangan</span><span>Konsultasi</span><span>Problem Solving</span><span>User Experience</span><span>Produk Digital</span>
        <span>Strategi</span><span>Desain</span><span>Pengembangan</span><span>Konsultasi</span><span>Problem Solving</span><span>User Experience</span><span>Produk Digital</span>
      </div>
    </div>

    <section class="cta-ink pad">
      <img class="bgimg" src="/img/cta-bg.webp" width="1440" height="1024" loading="lazy" decoding="async" alt="" aria-hidden="true" />
      <div class="wrap" style="position:relative">
        <span class="eyebrow reveal">// Mari Bicara</span>
        <h2 class="h2 reveal d1" style="margin:24px 0 36px">Belum yakin butuh yang mana?</h2>
        <div class="reveal d2">
          <a href={waHero} class="btn on-ink" target="_blank" rel="noopener" data-wa="cta" data-page="/layanan">Konsultasi Gratis<span class="arr">↗</span></a>
        </div>
      </div>
    </section>
  </main>
</Base>
