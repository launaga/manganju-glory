---
import '../../styles/admin.css';
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" /><title>Atur Password — MGL Admin</title>
  </head>
  <body class="admin-root">
    <main class="login-wrap"><div class="login-card">
      <p class="login-brand">:}MGL<span class="dot">.</span></p>
      <p class="login-sub">Buat password baru minimal 12 karakter.</p>
      <form id="resetForm" novalidate>
        <div class="field"><label for="password">Password baru</label><input class="input" id="password" type="password" autocomplete="new-password" minlength="12" required /></div>
        <div class="field"><label for="confirm">Ulangi password</label><input class="input" id="confirm" type="password" autocomplete="new-password" minlength="12" required /></div>
        <button class="btn btn-primary btn-block" id="submitBtn" type="submit">Simpan password</button>
        <p class="msg" id="msg" role="status" aria-live="polite"></p>
      </form>
    </div></main>
    <script>
      import { resetPassword } from '../../lib/auth';
      const token = new URLSearchParams(location.search).get('token') ?? '';
      const form = document.getElementById('resetForm') as HTMLFormElement;
      const password = document.getElementById('password') as HTMLInputElement;
      const confirm = document.getElementById('confirm') as HTMLInputElement;
      const btn = document.getElementById('submitBtn') as HTMLButtonElement;
      const msg = document.getElementById('msg') as HTMLParagraphElement;
      if (!token) { msg.textContent = 'Tautan tidak valid.'; msg.className = 'msg error'; btn.disabled = true; }
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (password.value.length < 12) { msg.textContent = 'Password minimal 12 karakter.'; msg.className = 'msg error'; return; }
        if (password.value !== confirm.value) { msg.textContent = 'Password tidak sama.'; msg.className = 'msg error'; return; }
        btn.disabled = true; btn.textContent = 'Menyimpan…';
        const result = await resetPassword(token, password.value);
        msg.textContent = result.message ?? (result.ok ? 'Password berhasil disimpan.' : 'Gagal menyimpan password.');
        msg.className = `msg ${result.ok ? 'ok' : 'error'}`;
        if (result.ok) setTimeout(() => location.replace('/admin/login'), 1200);
        else { btn.disabled = false; btn.textContent = 'Simpan password'; }
      });
    </script>
  </body>
</html>
