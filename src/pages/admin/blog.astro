---
import AdminLayout from '../../layouts/AdminLayout.astro';
import PageHeader from '../../components/admin/PageHeader.astro';
---
<AdminLayout title="Blog">
  <PageHeader title="Blog" description="Kelola artikel blog." />
  <div id="root"></div>
  <script>
    import { renderList } from '../../lib/admin/list';
    import { blogListConfig } from '../../lib/admin/collections';
    import { list } from '../../lib/admin/db';
    const cats = (await list('blog_categories', { order: { column: 'name', ascending: true } }))
      .map((c) => ({ value: c.id as string, label: c.name as string }));
    renderList(document.getElementById('root')!, blogListConfig(cats));
  </script>
</AdminLayout>
