---
import '../../styles/admin.css';
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" /><title>Buat / Reset Password — MGL Admin</title>
  </head>
  <body class="admin-root">
    <main class="login-wrap"><div class="login-card">
      <p class="login-brand">:}MGL<span class="dot">.</span></p>
      <p class="login-sub">Masukkan email admin. Tautan sekali pakai berlaku 30 menit.</p>
      <form id="requestForm" novalidate>
        <div class="field"><label for="email">Email</label><input class="input" id="email" type="email" autocomplete="email" required /></div>
        <button class="btn btn-primary btn-block" id="submitBtn" type="submit">Kirim tautan</button>
        <p class="msg" id="msg" role="status" aria-live="polite"></p>
        <p style="text-align:center;margin-top:16px"><a href="/admin/login" style="font-size:13px">← Kembali ke login</a></p>
      </form>
    </div></main>
    <script>
      import { requestPassword } from '../../lib/auth';
      const form = document.getElementById('requestForm') as HTMLFormElement;
      const email = document.getElementById('email') as HTMLInputElement;
      const btn = document.getElementById('submitBtn') as HTMLButtonElement;
      const msg = document.getElementById('msg') as HTMLParagraphElement;
      form.addEventListener('submit', async (event) => {
        event.preventDefault(); if (!email.value.trim()) return;
        btn.disabled = true; btn.textContent = 'Mengirim…'; msg.textContent = '';
        const result = await requestPassword(email.value.trim());
        msg.textContent = result.message ?? (result.ok ? 'Jika email terdaftar, tautan sudah dikirim.' : 'Gagal mengirim tautan.');
        msg.className = `msg ${result.ok ? 'ok' : 'error'}`;
        btn.disabled = false; btn.textContent = 'Kirim tautan';
      });
    </script>
  </body>
</html>
