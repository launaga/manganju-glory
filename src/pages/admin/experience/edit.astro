---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHeader from '../../../components/admin/PageHeader.astro';
---
<AdminLayout title="Edit Pengalaman">
  <PageHeader title="Edit Pengalaman" crumbs={[{label:"Pengalaman",href:"/admin/experience"},{label:"Edit"}]} />
  <div id="root"></div>
  <script>
    import { initEditor } from '../../../lib/admin/editor';
    import { experienceEditorConfig } from '../../../lib/admin/collections';
    const id = new URLSearchParams(location.search).get('id') ?? undefined;
    initEditor(document.getElementById('root')!, experienceEditorConfig, id);
  </script>
</AdminLayout>
