import Base from '../../layouts/Base.astro';
const body = "<section class=\"hero wrap\" style=\"padding-top:clamp(120px,16vh,180px);padding-bottom:clamp(48px,6vw,96px)\"> <div class=\"shead reveal\"><div class=\"label\"><span class=\"eyebrow\">// Work</span><span class=\"folio\">01</span></div></div> <h1 class=\"h1 reveal d1\" style=\"max-width:14ch\">Work.</h1> <p class=\"lead reveal d2\" style=\"margin-top:20px\">These are the projects where I solved real website problems. The interesting part is always the context behind each decision — and the trade-offs that came with it.</p> </section> <hr class=\"hair\" style=\"margin:0 var(--gut)\"> <section class=\"pad-sm wrap\"> <div class=\"shead reveal\"> <div class=\"label\"> <div><span class=\"eyebrow\">// 02 — Selected Work</span><h2 class=\"h2\" style=\"margin-top:18px\">Featured projects.</h2><p class=\"lead\" style=\"margin-top:16px;max-width:64ch\">A selection that shows the process, the thinking, and how I approach digital problems. Not everything I have built — the part that best describes how I work.</p></div> <span class=\"folio\">02</span> </div> </div> <div class=\"proj\" id=\"featuredList\"> <a class=\"proj-row\" href=\"https://eyelevel-id.com/\" target=\"_blank\" rel=\"noopener noreferrer\" data-img=\"/img/work/eyelevel-id.webp\"> <span class=\"pidx\">/01</span> <div class=\"pmain\"> <h3 class=\"h3\">Eyelevel-id</h3> <div class=\"ptags\">.Creator  .WordPress</div> </div> <p class=\"pdesc\">A digital marketing agency in Jakarta. The challenge: build credibility without looking like every other vendor. I translated their design guidelines into a WordPress site that positions them as a strategic Google Partner rather than a service list.</p> <div class=\"pthumb\"> <img src=\"/img/work/eyelevel-id.webp\" alt=\"Screenshot of the Eyelevel-id project\" width=\"470\" height=\"557\" loading=\"lazy\" decoding=\"async\"> </div> <span class=\"ext\">Visit ↗</span> </a><a class=\"proj-row\" href=\"https://www.addededucation.com/\" target=\"_blank\" rel=\"noopener noreferrer\" data-img=\"/img/work/addededucation.webp\"> <span class=\"pidx\">/02</span> <div class=\"pmain\"> <h3 class=\"h3\">AddedEducation</h3> <div class=\"ptags\">.Creator  .WordPress</div> </div> <p class=\"pdesc\">An education consultancy whose old site buried its main message under feature lists and generic clichés, leaving parents unsure what made them different. I rebuilt it in the language parents actually use — premium in feel, proving credibility with concrete numbers before doubt sets in.</p> <div class=\"pthumb\"> <img src=\"/img/work/addededucation.webp\" alt=\"Screenshot of the AddedEducation project\" width=\"632\" height=\"637\" loading=\"lazy\" decoding=\"async\"> </div> <span class=\"ext\">Visit ↗</span> </a><a class=\"proj-row\" href=\"https://ipasindonesia.org/\" target=\"_blank\" rel=\"noopener noreferrer\" data-img=\"/img/work/ipas-indonesia.webp\"> <span class=\"pidx\">/03</span> <div class=\"pmain\"> <h3 class=\"h3\">Ipas Indonesia</h3> <div class=\"ptags\">.Redesign  .WordPress</div> </div> <p class=\"pdesc\">A reproductive health NGO expanding access to safe post-abortion care. Their old site had drifted away from the new international design system. I rebuilt it to align with the global brand without sacrificing what the Indonesian audience responds to.</p> <div class=\"pthumb\"> <img src=\"/img/work/ipas-indonesia.webp\" alt=\"Screenshot of the Ipas Indonesia project\" width=\"947\" height=\"857\" loading=\"lazy\" decoding=\"async\"> </div> <span class=\"ext\">Visit ↗</span> </a><a class=\"proj-row\" href=\"https://jakartafeminist.com/\" target=\"_blank\" rel=\"noopener noreferrer\" data-img=\"/img/work/jakarta-feminist.webp\"> <span class=\"pidx\">/04</span> <div class=\"pmain\"> <h3 class=\"h3\">Jakarta Feminist</h3> <div class=\"ptags\">.Redesign  .WordPress</div> </div> <p class=\"pdesc\">A feminist organisation strengthening its advocacy. I consolidated editorial content, events, and resources into a single mobilisation hub — migrating from Wix Editor to WordPress, supporting Women&#39;s March Jakarta, FemFest, and more.</p> <div class=\"pthumb\"> <img src=\"/img/work/jakarta-feminist.webp\" alt=\"Screenshot of the Jakarta Feminist project\" width=\"1200\" height=\"579\" loading=\"lazy\" decoding=\"async\"> </div> <span class=\"ext\">Visit ↗</span> </a><a class=\"proj-row\" href=\"https://carilayanan.com/\" target=\"_blank\" rel=\"noopener noreferrer\" data-img=\"/img/work/cari-layanan.webp\"> <span class=\"pidx\">/05</span> <div class=\"pmain\"> <h3 class=\"h3\">Cari Layanan</h3> <div class=\"ptags\">.WordPress</div> </div> <p class=\"pdesc\">A crisis directory for survivors of gender-based violence during COVID-19. I built a WordPress directory mapping verified services by location and need — confidential, immediately accessible, and able to scale to thousands of users.</p> <div class=\"pthumb\"> <img src=\"/img/work/cari-layanan.webp\" alt=\"Screenshot of the Cari Layanan project\" width=\"861\" height=\"822\" loading=\"lazy\" decoding=\"async\"> </div> <span class=\"ext\">Visit ↗</span> </a><a class=\"proj-row\" href=\"https://www.thearisefoundation.com/\" target=\"_blank\" rel=\"noopener noreferrer\" data-img=\"/img/work/the-arise-foundation.webp\"> <span class=\"pidx\">/06</span> <div class=\"pmain\"> <h3 class=\"h3\">The Arise Foundation</h3> <div class=\"ptags\">.Wix Studio  .Gamify</div> </div> <p class=\"pdesc\">A youth-driven initiative in Tanzania. The challenge: a gamified quiz for students. I told their impact story through specific outcomes — 1,300 lunches a day, 100 laptops — turning a sense of connection into donor action.</p> <div class=\"pthumb\"> <img src=\"/img/work/the-arise-foundation.webp\" alt=\"Screenshot of the The Arise Foundation project\" width=\"945\" height=\"816\" loading=\"lazy\" decoding=\"async\"> </div> <span class=\"ext\">Visit ↗</span> </a><a class=\"proj-row\" href=\"https://www.projectnamboudik.com/\" target=\"_blank\" rel=\"noopener noreferrer\" data-img=\"/img/work/project-nambo-udik.webp\"> <span class=\"pidx\">/07</span> <div class=\"pmain\"> <h3 class=\"h3\">Project Nambo Udik</h3> <div class=\"ptags\">.Wix Studio</div> </div> <p class=\"pdesc\">A community project raising literacy and child health in rural Indonesia. I built a Wix Studio site documenting their &quot;Reading Revolution&quot; and Sports Day — the kind of transparency that earns donor trust.</p> <div class=\"pthumb\"> <img src=\"/img/work/project-nambo-udik.webp\" alt=\"Screenshot of the Project Nambo Udik project\" width=\"937\" height=\"822\" loading=\"lazy\" decoding=\"async\"> </div> <span class=\"ext\">Visit ↗</span> </a><a class=\"proj-row\" href=\"https://www.supportspace.online/\" target=\"_blank\" rel=\"noopener noreferrer\" data-img=\"/img/work/support-space.webp\"> <span class=\"pidx\">/08</span> <div class=\"pmain\"> <h3 class=\"h3\">Support Space</h3> <div class=\"ptags\">.Wix Studio</div> </div> <p class=\"pdesc\">A platform for a mental health professional. The challenge: build trust without feeling clinically cold. I designed an intimate Wix Studio experience balancing warmth with credibility.</p> <div class=\"pthumb\"> <img src=\"/img/work/support-space.webp\" alt=\"Screenshot of the Support Space project\" width=\"937\" height=\"817\" loading=\"lazy\" decoding=\"async\"> </div> <span class=\"ext\">Visit ↗</span> </a><a class=\"proj-row\" href=\"https://www.nikhilbohra.com/\" target=\"_blank\" rel=\"noopener noreferrer\" data-img=\"/img/work/nikhil-bohra.webp\"> <span class=\"pidx\">/09</span> <div class=\"pmain\"> <h3 class=\"h3\">Nikhil Bohra</h3> <div class=\"ptags\">.Wix Editor</div> </div> <p class=\"pdesc\">An information hub for an Indian-American driver in the Formula Regional European Championship. I framed his journey from Italian F4 to the FRECA podium — a career narrative signalling readiness to sponsors.</p> <div class=\"pthumb\"> <img src=\"/img/work/nikhil-bohra.webp\" alt=\"Screenshot of the Nikhil Bohra project\" width=\"941\" height=\"832\" loading=\"lazy\" decoding=\"async\"> </div> <span class=\"ext\">Visit ↗</span> </a><a class=\"proj-row\" href=\"https://farmfreshbites.wixstudio.com/farm-fresh-bites\" target=\"_blank\" rel=\"noopener noreferrer\" data-img=\"/img/work/farm-fresh-bites.webp\"> <span class=\"pidx\">/10</span> <div class=\"pmain\"> <h3 class=\"h3\">Farm Fresh Bites</h3> <div class=\"ptags\">.Wix Studio  .eCommerce</div> </div> <p class=\"pdesc\">A hyperlocal business in Mumbai delivering responsibly sourced exotic fruit. The challenge: sell a premium product while keeping a real social mission visible. I built a Wix Studio storefront that does both without either undercutting the other.</p> <div class=\"pthumb\"> <img src=\"/img/work/farm-fresh-bites.webp\" alt=\"Screenshot of the Farm Fresh Bites project\" width=\"1145\" height=\"750\" loading=\"lazy\" decoding=\"async\"> </div> <span class=\"ext\">Visit ↗</span> </a> </div> </section> <section class=\"pad-sm wrap\"> <div class=\"shead reveal\"> <div class=\"label\"> <div><span class=\"eyebrow\">// 03 — Other</span><h2 class=\"h2\" style=\"margin-top:18px\">Other projects.</h2><p class=\"lead\" style=\"margin-top:16px;max-width:60ch\">Other work built over the years — from web design and design exploration to open-source projects people actually use.</p></div> <span class=\"folio\">03</span> </div> </div> <div class=\"more-grid reveal\" id=\"moreList\"> <a class=\"more-card\" href=\"https://credithealth.vercel.app/\" target=\"_blank\" rel=\"noopener noreferrer\"> <div class=\"mthumb\"> <img src=\"/img/work/credit-health.webp\" alt=\"Screenshot of the Credit Health project\" width=\"1200\" height=\"675\" loading=\"lazy\" decoding=\"async\"> </div> <div class=\"mt\"> <h3 class=\"h3\">Credit Health</h3> <span class=\"mtag\">.Creator .Vercel .GitHub</span> </div> <p>Built because nearly every decent personal finance tool charges $99–109 a year and locks basic features behind a paywall. I wanted to prove a full-featured financial dashboard could be free.</p> <span class=\"open\">View site ↗</span> </a><a class=\"more-card\" href=\"https://dashboard-gilt-six-hkvkubuygh.vercel.app/\" target=\"_blank\" rel=\"noopener noreferrer\"> <div class=\"mthumb\"> <img src=\"/img/work/spotless-web-app.webp\" alt=\"Screenshot of the Spotless Web App project\" width=\"1200\" height=\"580\" loading=\"lazy\" decoding=\"async\"> </div> <div class=\"mt\"> <h3 class=\"h3\">Spotless Web App</h3> <span class=\"mtag\">.Creator .Vercel .GitHub</span> </div> <p>A 3-portal SaaS management system running the Spotless car wash ecosystem. React 19 + TypeScript + Recharts, with a real-time POS interface, cart management, and multi-payment support.</p> <span class=\"open\">View site ↗</span> </a><a class=\"more-card\" href=\"https://app-eight-phi-12.vercel.app/\" target=\"_blank\" rel=\"noopener noreferrer\"> <div class=\"mthumb\"> <img src=\"/img/work/spotless-mobile-app.webp\" alt=\"Screenshot of the Spotless Mobile App project\" width=\"537\" height=\"922\" loading=\"lazy\" decoding=\"async\"> </div> <div class=\"mt\"> <h3 class=\"h3\">Spotless Mobile App</h3> <span class=\"mtag\">.Creator .Vercel</span> </div> <p>A premium car wash mobile app reimagined from Karcher. React 19 + TypeScript, native in feel — 30+ screens: onboarding, merchant search with maps, booking with add-ons, token wallet, QR, and 10 payment methods.</p> <span class=\"open\">View site ↗</span> </a><a class=\"more-card\" href=\"https://dashboard-gilt-six-hkvkubuygh.vercel.app/\" target=\"_blank\" rel=\"noopener noreferrer\"> <div class=\"mthumb\"> <img src=\"/img/work/spotless-pos.webp\" alt=\"Screenshot of the Spotless POS project\" width=\"1200\" height=\"529\" loading=\"lazy\" decoding=\"async\"> </div> <div class=\"mt\"> <h3 class=\"h3\">Spotless POS</h3> <span class=\"mtag\">.Creator .Vercel</span> </div> <p>A full-featured point-of-sale interface for premium car wash operations. Split-screen layout with a 3-column product grid (Self Service, Rollover, Automatic, Detailing, Add-on) and a real-time billing panel.</p> <span class=\"open\">View site ↗</span> </a><a class=\"more-card\" href=\"https://indycar-fleet-hub.lovable.app/\" target=\"_blank\" rel=\"noopener noreferrer\"> <div class=\"mthumb\"> <img src=\"/img/work/nusantara-rent.webp\" alt=\"Screenshot of the Nusantara Rent project\" width=\"1200\" height=\"555\" loading=\"lazy\" decoding=\"async\"> </div> <div class=\"mt\"> <h3 class=\"h3\">Nusantara Rent</h3> <span class=\"mtag\">.Creator .Lovable</span> </div> <p>A car rental service with drivers operating across cities. The challenge: a fleet spanning family Avanzas to VVIP Alphards had to read clearly in one screen without making anyone feel they were in the wrong place. I built a dark-and-gold hierarchy that leads with capacity and price, then cut the booking path down to a single step into WhatsApp.</p> <span class=\"open\">View site ↗</span> </a><a class=\"more-card\" href=\"https://rasa-lokal-sentuh-asia.lovable.app/\" target=\"_blank\" rel=\"noopener noreferrer\"> <div class=\"mthumb\"> <img src=\"/img/work/rasalokal.webp\" alt=\"Screenshot of the Rasalokal project\" width=\"1200\" height=\"575\" loading=\"lazy\" decoding=\"async\"> </div> <div class=\"mt\"> <h3 class=\"h3\">Rasalokal</h3> <span class=\"mtag\">.Creator .Lovable</span> </div> <p>A platform connecting small-batch Indonesian snack producers to modern distribution and marketplaces. The classic trap in this category: the &quot;from a home kitchen&quot; story reads sentimental until the product itself stops looking serious. I split the two audiences that had been colliding — retail buyers and B2B buyers — starting at the navigation.</p> <span class=\"open\">View site ↗</span> </a> </div> </section> <div class=\"marquee accent\" aria-hidden=\"true\"> <div class=\"marquee-track\"> <span>Strategy</span><span>Design</span><span>Development</span><span>Consulting</span><span>Problem Solving</span><span>User Experience</span><span>Digital Products</span> <span>Strategy</span><span>Design</span><span>Development</span><span>Consulting</span><span>Problem Solving</span><span>User Experience</span><span>Digital Products</span> </div> </div> <section class=\"cta-ink pad\"> <img class=\"bgimg\" src=\"/img/cta-bg.webp\" width=\"1440\" height=\"1024\" loading=\"lazy\" decoding=\"async\" alt=\"\" aria-hidden=\"true\"> <div class=\"wrap\" style=\"position:relative\"> <span class=\"eyebrow reveal\">// Let's talk</span> <h2 class=\"h2 reveal d1\" style=\"margin:24px 0 36px\">Got a problem worth solving?</h2> <div class=\"reveal d2\"><a href=\"https://wa.me/6285927277560?text=Hi!%20I%20saw%20your%20portfolio%20and%20I'd%20like%20to%20discuss%20a%20similar%20project...\" class=\"btn on-ink\" target=\"_blank\" rel=\"noopener\" data-wa=\"cta\" data-page=\"/en/work.html\"> Free Consultation<span class=\"arr\">↗</span> </a></div> </div> </section>";
const extraSchema = [{"@type":"CollectionPage","@id":"https://mglportfolio.vercel.app/en/work#collection","url":"https://mglportfolio.vercel.app/en/work","name":"Work — Manganju Glory Laurencius","description":"Website projects across WordPress, Wix Studio, and web apps.","inLanguage":"en-US","isPartOf":{"@id":"https://mglportfolio.vercel.app/#website"},"author":{"@id":"https://mglportfolio.vercel.app/#person"},"mainEntity":{"@type":"ItemList","numberOfItems":16,"itemListElement":[{"@type":"ListItem","position":1,"name":"Eyelevel-id","url":"https://eyelevel-id.com/"},{"@type":"ListItem","position":2,"name":"AddedEducation","url":"https://www.addededucation.com/"},{"@type":"ListItem","position":3,"name":"Ipas Indonesia","url":"https://ipasindonesia.org/"},{"@type":"ListItem","position":4,"name":"Jakarta Feminist","url":"https://jakartafeminist.com/"},{"@type":"ListItem","position":5,"name":"Cari Layanan","url":"https://carilayanan.com/"},{"@type":"ListItem","position":6,"name":"The Arise Foundation","url":"https://www.thearisefoundation.com/"},{"@type":"ListItem","position":7,"name":"Project Nambo Udik","url":"https://www.projectnamboudik.com/"},{"@type":"ListItem","position":8,"name":"Support Space","url":"https://www.supportspace.online/"},{"@type":"ListItem","position":9,"name":"Nikhil Bohra","url":"https://www.nikhilbohra.com/"},{"@type":"ListItem","position":10,"name":"Farm Fresh Bites","url":"https://farmfreshbites.wixstudio.com/farm-fresh-bites"},{"@type":"ListItem","position":11,"name":"Credit Health","url":"https://credithealth.vercel.app/"},{"@type":"ListItem","position":12,"name":"Spotless Web App","url":"https://dashboard-gilt-six-hkvkubuygh.vercel.app/"},{"@type":"ListItem","position":13,"name":"Spotless Mobile App","url":"https://app-eight-phi-12.vercel.app/"},{"@type":"ListItem","position":14,"name":"Spotless POS","url":"https://dashboard-gilt-six-hkvkubuygh.vercel.app/"},{"@type":"ListItem","position":15,"name":"Nusantara Rent","url":"https://indycar-fleet-hub.lovable.app/"},{"@type":"ListItem","position":16,"name":"Rasalokal","url":"https://rasa-lokal-sentuh-asia.lovable.app/"}]}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://mglportfolio.vercel.app/en"},{"@type":"ListItem","position":2,"name":"Work","item":"https://mglportfolio.vercel.app/en/work"}]}];
