---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import seo from '../../data/seo/work.json';

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = all.filter((p) => p.data.featured);
const more = all.filter((p) => !p.data.featured);
const waCta = "https://wa.me/6285927277560?text=Hi!%20I%20saw%20your%20portfolio%20and%20I'd%20like%20to%20discuss%20a%20similar%20project...";

const collectionSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://haloglory.com/en' },
    { '@type': 'ListItem', position: 2, name: 'Work', item: 'https://haloglory.com/en/work' },
  ],
};
---

<Base
  lang="en"
  title={seo.title_en}
  description={seo.desc_en}
  image={seo.ogImage}
  idPath="/portofolio"
  enPath="/en/work"
  extraSchema={[collectionSchema]}
>
  <main id="page-work-en" class="page">
    <section class="hero wrap" style="padding-top:clamp(120px,16vh,180px);padding-bottom:clamp(48px,6vw,96px)">
      <div class="shead reveal"><div class="label"><span class="eyebrow">// Work</span><span class="folio">01</span></div></div>
      <h1 class="h1 reveal d1" style="max-width:14ch">Work.</h1>
      <p class="lead reveal d2" style="margin-top:20px">These are the projects where I solved real website problems. The most interesting part is always the context behind each decision — and the trade-offs that came with it.</p>
    </section>
    <hr class="hair" style="margin:0 var(--gut)">

    <section class="pad-sm wrap">
      <div class="shead reveal">
        <div class="label">
          <div><span class="eyebrow">// 02 — Selected Work</span><h2 class="h2" style="margin-top:18px">Featured projects.</h2><p class="lead" style="margin-top:16px;max-width:64ch">A selection that shows my process, my thinking, and my approach to solving digital challenges. These are not my only projects — they are the ones that best describe how I work.</p></div>
          <span class="folio">02</span>
        </div>
      </div>
      <div class="proj" id="featuredList">
        {featured.map((p, i) => (
          <a class="proj-row" href={p.data.url} target="_blank" rel="noopener noreferrer" data-img={p.data.image}>
            <span class="pidx">/{String(i + 1).padStart(2, '0')}</span>
            <div class="pmain">
              <h3 class="h3">{p.data.name}</h3>
              <div class="ptags">{p.data.tags.map((t) => `.${t}`).join('  ')}</div>
            </div>
            <p class="pdesc">{p.data.desc_en}</p>
            <div class="pthumb">
              <img src={p.data.image} alt={p.data.alt_en} width={p.data.imageWidth} height={p.data.imageHeight} loading="lazy" decoding="async" />
            </div>
            <span class="ext">Visit ↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="pad-sm wrap">
      <div class="shead reveal">
        <div class="label">
          <div><span class="eyebrow">// 03 — More</span><h2 class="h2" style="margin-top:18px">Other projects.</h2><p class="lead" style="margin-top:16px;max-width:60ch">Other work I've built over the years — from web design and design explorations to open-source projects that are actually in use.</p></div>
          <span class="folio">03</span>
        </div>
      </div>
      <div class="more-grid reveal" id="moreList">
        {more.map((p) => (
          <a class="more-card" href={p.data.url} target="_blank" rel="noopener noreferrer">
            <div class="mthumb">
              <img src={p.data.image} alt={p.data.alt_en} width={p.data.imageWidth} height={p.data.imageHeight} loading="lazy" decoding="async" />
            </div>
            <div class="mt">
              <h3 class="h3">{p.data.name}</h3>
              <span class="mtag">{p.data.tags.map((t) => `.${t}`).join(' ')}</span>
            </div>
            <p>{p.data.desc_en}</p>
            <span class="open">View site ↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="pad-sm wrap">
      <div class="shead reveal">
        <div class="label">
          <div><span class="eyebrow">// 04 — Case Studies</span><h2 class="h2" style="margin-top:18px">The story behind two projects.</h2><p class="lead" style="margin-top:16px;max-width:60ch">The grid above shows the results. These two pages show how the decisions were made — including the wrong ones.</p></div>
          <span class="folio">04</span>
        </div>
      </div>
      <div class="svc-hub reveal">
        <a class="svc-hub-card" href="/en/work/redesign-website-ngo-london">
          <span class="n">/01 — NGO Website Redesign in London</span>
          <h3>Why This NGO's Website Failed at Two Previous Agencies</h3>
          <p>A well-known NGO in London had already burned budget at two agencies. Both produced beautiful sites. Neither worked.</p>
          <span class="open">Read the case study ↗</span>
        </a><a class="svc-hub-card" href="/en/work/jakarta-feminist">
          <span class="n">/02 — Jakarta Feminist</span>
          <h3>Three Websites, Five Years: What Happens When a Client Refuses Features</h3>
          <p>It started as a contract to build three websites. It turned into almost five years of support — and changed how I judge my own work.</p>
          <span class="open">Read the case study ↗</span>
        </a>
      </div>
    </section>

    <div class="marquee accent" aria-hidden="true">
      <div class="marquee-track">
        <span>Strategy</span><span>Design</span><span>Development</span><span>Consulting</span><span>Problem Solving</span><span>User Experience</span><span>Digital Products</span>
        <span>Strategy</span><span>Design</span><span>Development</span><span>Consulting</span><span>Problem Solving</span><span>User Experience</span><span>Digital Products</span>
      </div>
    </div>

    <section class="cta-ink pad">
      <img class="bgimg" src="/img/cta-bg.webp" width="1440" height="1024" loading="lazy" decoding="async" alt="" aria-hidden="true" />
      <div class="wrap" style="position:relative">
        <span class="eyebrow reveal">// Let's talk</span>
        <h2 class="h2 reveal d1" style="margin:24px 0 36px">Got a problem worth solving?</h2>
        <div class="reveal d2"><a href={waCta} class="btn on-ink" target="_blank" rel="noopener" data-wa="cta" data-page="/en/work">
          Free Consultation<span class="arr">↗</span>
        </a></div>
      </div>
    </section>
  </main>
</Base>
