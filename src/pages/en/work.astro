<Base lang="en" title="Web Design Portfolio — WordPress & Wix | MGL" description="Website projects across WordPress, Wix Studio, and web apps — for NGOs, agencies, and businesses in Jakarta, London, Mumbai, and Tanzania." idPath="/portofolio" enPath="/en/work" extraSchema={extraSchema}>
  <Fragment set:html={body} />
</Base>
