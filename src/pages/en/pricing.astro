---
import Base from '../../layouts/Base.astro';
import PricingBody from '../../components/PricingBody.astro';
import pricing from '../../data/pricing.json';

const extraSchema = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://mglportfolio.vercel.app/en' },
      { '@type': 'ListItem', position: 2, name: 'Pricing', item: 'https://mglportfolio.vercel.app/en/pricing' },
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: pricing.faq.map((q) => ({
      '@type': 'Question',
      name: q.q_en,
      acceptedAnswer: { '@type': 'Answer', text: q.a_en },
    })),
  },
];
---

<Base
  lang="en"
  title="Website Pricing — Packages & Costs | MGL"
  description="Website pricing from Rp5,000,000. Company profile, e-commerce, and custom packages — including what's not included."
  idPath="/harga"
  enPath="/en/pricing"
  extraSchema={extraSchema}
>
  <PricingBody lang="en" />
</Base>
