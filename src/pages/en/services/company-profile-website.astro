import Base from '../../../layouts/Base.astro';
const body = "<section class=\"hero wrap\"> <div class=\"shead reveal\"> <div class=\"label\"><span class=\"eyebrow\">// Services</span><span class=\"folio\">01</span></div> </div> <h1 class=\"h1 reveal d1\" style=\"max-width:22ch;margin-top:18px;font-size:clamp(32px,4.4vw,60px)\">Company Profile Websites — Starting from Strategy, Not a Template</h1> <p class=\"lead reveal d2\" style=\"margin-top:22px\">A website that makes people understand what you do in thirty seconds — and why it matters to them.</p> <div class=\"reveal d3\" style=\"margin-top:32px;display:flex;gap:14px;flex-wrap:wrap\"> <a href=\"https://wa.me/6285927277560?text=Hi!%20I'd%20like%20to%20talk%20about%20a%20company%20profile%20website...\" class=\"btn\" target=\"_blank\" rel=\"noopener\" data-wa=\"hero\" data-page=\"/en/services/company-profile-website.html\"> Free Consultation<span class=\"arr\">↗</span> </a> <a href=\"/en/contact\" class=\"btn ghost\">Contact me <span class=\"arr\">↗</span></a> </div> </section> <hr class=\"hair\" style=\"margin:0 var(--gut)\"> <section class=\"pad-sm wrap\"> <div class=\"shead reveal\"> <div class=\"label\"><span class=\"eyebrow\">// 02 — The problem</span><span class=\"folio\">02</span></div> </div> <div class=\"persp\"> <div class=\"reveal\"><p class=\"big\">The problem is rarely the visual design.</p></div> <div class=\"reveal d1\"> <p class=\"lead\" style=\"margin-bottom:20px\">Almost every business that approaches me for a company profile opens with the same sentence: our site looks dated. Twenty minutes in, the real problem has usually surfaced somewhere else entirely.</p><p class=\"lead\" style=\"margin-bottom:20px\">The site has an About Us, a Mission &amp; Vision, and nine services described in sentences that could belong to any company in the industry. Visitors read all of it and still cannot say what makes you different. Not because the design is bad — because the site explains what you do without ever explaining why it matters.</p><p class=\"lead\" style=\"margin-bottom:20px\">A redesign that only changes the typeface and the palette produces a tidier site with exactly the same problem. So these projects do not start with colour. They start with an uncomfortable question: if a visitor reads only one sentence here, which sentence should it be?</p> </div> </div> </section> <hr class=\"hair\" style=\"margin:0 var(--gut)\"> <section class=\"pad-sm wrap\"> <div class=\"shead reveal\"> <div class=\"label\"> <div><span class=\"eyebrow\">// 03 — What's included</span><h2 class=\"h2\" style=\"margin-top:18px;max-width:20ch\">What you actually get.</h2></div> <span class=\"folio\">03</span> </div> </div> <div class=\"deflist reveal\"> <div><b>Discovery workshop</b><p>A structured session on positioning, audience, and what you are actually selling. The output is useful beyond the website.</p></div><div><b>Information architecture</b><p>Page map and message hierarchy. What gets read first, what follows, what should be cut.</p></div><div><b>Interface design</b><p>Full desktop and mobile design, built on a consistent system rather than drawn page by page.</p></div><div><b>Build</b><p>WordPress or Wix, chosen together based on who maintains it day to day.</p></div><div><b>Responsive</b><p>Tested on real phones, not only in a browser simulator.</p></div><div><b>Basic SEO</b><p>Heading structure, meta, sitemap, speed, and URLs correct from day one.</p></div><div><b>Training</b><p>A recorded session so your team can change text and images without contacting me.</p></div> </div> </section> <section class=\"pad-sm wrap\"> <div class=\"shead reveal\"> <div class=\"label\"> <div> <span class=\"eyebrow\">// 04 — Fit</span> <h2 class=\"h2\" style=\"margin-top:18px;max-width:22ch\">Who this is for — and who it isn't.</h2> <p class=\"lead\" style=\"margin-top:16px;max-width:62ch\">The right column matters as much as the left. I would rather lose the project here than have us both discover it in week five.</p> </div> <span class=\"folio\">04</span> </div> </div> <div class=\"fit-grid reveal\"> <div class=\"fit yes\"><b>A good fit if</b><ul><li>Companies with real clients and a real reputation, whose site does not reflect it.</li><li>Businesses that have to re-explain what they do in every meeting.</li><li>Organisations that need to look credible to partners, funders, or investors.</li><li>Teams that want to manage their own content after launch.</li></ul></div> <div class=\"fit no\"><b>Not a fit if</b><ul><li>You need it live next week. Proper discovery alone takes longer than that.</li><li>You already know exactly which pages you want and just need execution. That is legitimate work — but not mine, and you would be paying for a process you do not need.</li><li>You are looking for the lowest price. There is always someone cheaper.</li><li>Nobody on your side can make decisions. Projects without a decision-maker never finish.</li></ul></div> </div> </section> <hr class=\"hair\" style=\"margin:0 var(--gut)\"> <section class=\"pad-sm wrap\"> <div class=\"shead reveal\"> <div class=\"label\"> <div> <span class=\"eyebrow\">// 05 — Process</span> <h2 class=\"h2\" style=\"margin-top:18px\">How this runs.</h2> <p class=\"lead\" style=\"margin-top:16px;max-width:62ch\">2–4 weeks for a typical company profile. Longer if content is not ready or the page count is high.</p> </div> <span class=\"folio\">05</span> </div> </div> <div class=\"proc\"> <div class=\"proc-step reveal\"><div class=\"pn\">1.</div><h3>Discovery &amp; diagnosis</h3><p>Understanding the business, audience, and challenge. You get clear scope, a timeline, and an honest read on what is realistic.</p></div><div class=\"proc-step reveal\"><div class=\"pn\">2.</div><h3>Structure &amp; message</h3><p>Page map and message hierarchy agreed before a single pixel is drawn. The step most often skipped, and the one that decides the outcome.</p></div><div class=\"proc-step reveal\"><div class=\"pn\">3.</div><h3>Design &amp; build</h3><p>Regular updates, room for feedback, no surprises at launch.</p></div><div class=\"proc-step reveal\"><div class=\"pn\">4.</div><h3>Launch &amp; handover</h3><p>A site that works on day one, training, and a plan for day one hundred.</p></div> </div> </section> <section class=\"pad-sm wrap\"> <div class=\"shead reveal\"> <div class=\"label\"> <div> <span class=\"eyebrow\">// 06 — Pricing</span> <h2 class=\"h2\" style=\"margin-top:18px\">From IDR 5,000,000 (approx. USD 320)</h2> <p class=\"lead\" style=\"margin-top:16px;max-width:62ch\">Indicative conversion only; quoted in IDR. Depends on page count, content readiness, and integration complexity.</p> <div style=\"margin-top:26px\"><a href=\"/en/contact\" class=\"btn ghost\">Contact me <span class=\"arr\">↗</span></a></div> </div> <span class=\"folio\">06</span> </div> </div> </section> <section class=\"pad-sm wrap\"> <div class=\"shead reveal\"> <div class=\"label\"> <div><span class=\"eyebrow\">// 07 — Examples</span><h2 class=\"h2\" style=\"margin-top:18px\">Comparable work.</h2></div> <span class=\"folio\">07</span> </div> </div> <div class=\"more-grid reveal\"> <a class=\"more-card\" href=\"https://eyelevel-id.com/\" target=\"_blank\" rel=\"noopener noreferrer\"> <div class=\"mthumb\"><img src=\"/img/work/eyelevel-id.webp\" alt=\"Screenshot of the Eyelevel-id project\" width=\"470\" height=\"557\" loading=\"lazy\" decoding=\"async\"></div> <div class=\"mt\"><h3 class=\"h3\">Eyelevel-id</h3><span class=\"mtag\">.Creator .WordPress</span></div> <p>A digital marketing agency in Jakarta. The challenge: build credibility without looking like every other vendor. I translated their design guidelines into a WordPress site that positions them as a strategic Google Partner rather than a service list.</p> <span class=\"open\">View site ↗</span> </a><a class=\"more-card\" href=\"https://www.addededucation.com/\" target=\"_blank\" rel=\"noopener noreferrer\"> <div class=\"mthumb\"><img src=\"/img/work/addededucation.webp\" alt=\"Screenshot of the AddedEducation project\" width=\"632\" height=\"637\" loading=\"lazy\" decoding=\"async\"></div> <div class=\"mt\"><h3 class=\"h3\">AddedEducation</h3><span class=\"mtag\">.Creator .WordPress</span></div> <p>An education consultancy whose old site buried its main message under feature lists and generic clichés, leaving parents unsure what made them different. I rebuilt it in the language parents actually use — premium in feel, proving credibility with concrete numbers before doubt sets in.</p> <span class=\"open\">View site ↗</span> </a><a class=\"more-card\" href=\"https://ipasindonesia.org/\" target=\"_blank\" rel=\"noopener noreferrer\"> <div class=\"mthumb\"><img src=\"/img/work/ipas-indonesia.webp\" alt=\"Screenshot of the Ipas Indonesia project\" width=\"947\" height=\"857\" loading=\"lazy\" decoding=\"async\"></div> <div class=\"mt\"><h3 class=\"h3\">Ipas Indonesia</h3><span class=\"mtag\">.Redesign .WordPress</span></div> <p>A reproductive health NGO expanding access to safe post-abortion care. Their old site had drifted away from the new international design system. I rebuilt it to align with the global brand without sacrificing what the Indonesian audience responds to.</p> <span class=\"open\">View site ↗</span> </a> </div> <p class=\"lead\" style=\"margin-top:24px;font-size:15px\"> <a href=\"/en/work\" style=\"text-decoration:underline;text-underline-offset:4px\">See the full portfolio</a> — with the reasoning behind each decision.\n</p> </section> <hr class=\"hair\" style=\"margin:0 var(--gut)\"> <section class=\"pad-sm wrap\"> <div class=\"shead reveal\"> <div class=\"label\"> <div><span class=\"eyebrow\">// 08 — Questions</span><h2 class=\"h2\" style=\"margin-top:18px\">What people usually ask.</h2></div> <span class=\"folio\">08</span> </div> </div> <div class=\"faq reveal\"> <details> <summary><span class=\"fq\">/01</span>How many pages do we actually need?</summary> <p class=\"fa\">Fewer than you think. Most company profiles work with five to seven: home, about, services, proof of work, contact. Extra pages usually come from habit rather than need. If you cannot state a page&#39;s purpose in one sentence, it probably should not exist.</p> </details><details> <summary><span class=\"fq\">/02</span>WordPress or Wix?</summary> <p class=\"fa\">It depends on who maintains it. Wix is easier for non-technical people and sufficient for most company profiles. WordPress is more flexible and more ready to grow, but wants a little more attention. I build both, so I have no stake in pushing you either way. The decision happens in discovery.</p> </details><details> <summary><span class=\"fq\">/03</span>What if our content is not ready?</summary> <p class=\"fa\">That is the most common situation and not a problem — as long as we know upfront. I set the structure and message direction; you or your writer fill in the copy. What ruins timelines is starting design while hoping the content will catch up.</p> </details> </div> </section> <section class=\"cta-ink pad\"> <img class=\"bgimg\" src=\"/img/cta-bg.webp\" width=\"1440\" height=\"1024\" loading=\"lazy\" decoding=\"async\" alt=\"\" aria-hidden=\"true\"> <div class=\"wrap\" style=\"position:relative\"> <span class=\"eyebrow reveal\">// Let's talk</span> <h2 class=\"h2 reveal d1\" style=\"margin:24px 0 36px;max-width:20ch\">Sounds like a fit? Let's test that first.</h2> <div class=\"reveal d2\"> <a href=\"https://wa.me/6285927277560?text=Hi!%20I'd%20like%20to%20talk%20about%20a%20company%20profile%20website...\" class=\"btn on-ink\" target=\"_blank\" rel=\"noopener\" data-wa=\"cta\" data-page=\"/en/services/company-profile-website.html\"> Free Consultation<span class=\"arr\">↗</span> </a> </div> </div> </section>";
const extraSchema = [{"@type":"Service","name":"company profile website design","description":"Company profile websites that start from strategy, not a template. For businesses whose reputation is ahead of their website.","url":"https://haloglory.com/en/services/company-profile-website","serviceType":"Company Profile Website","provider":{"@id":"https://haloglory.com/#service"},"areaServed":{"@type":"Country","name":"Indonesia"},"inLanguage":"en-US"},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://haloglory.com/en"},{"@type":"ListItem","position":2,"name":"Services","item":"https://haloglory.com/en/services"},{"@type":"ListItem","position":3,"name":"Company Profile Website","item":"https://haloglory.com/en/services/company-profile-website"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How many pages do we actually need?","acceptedAnswer":{"@type":"Answer","text":"Fewer than you think. Most company profiles work with five to seven: home, about, services, proof of work, contact. Extra pages usually come from habit rather than need. If you cannot state a page's purpose in one sentence, it probably should not exist."}},{"@type":"Question","name":"WordPress or Wix?","acceptedAnswer":{"@type":"Answer","text":"It depends on who maintains it. Wix is easier for non-technical people and sufficient for most company profiles. WordPress is more flexible and more ready to grow, but wants a little more attention. I build both, so I have no stake in pushing you either way. The decision happens in discovery."}},{"@type":"Question","name":"What if our content is not ready?","acceptedAnswer":{"@type":"Answer","text":"That is the most common situation and not a problem — as long as we know upfront. I set the structure and message direction; you or your writer fill in the copy. What ruins timelines is starting design while hoping the content will catch up."}}]}];
