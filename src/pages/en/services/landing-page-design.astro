<Base lang="en" title="Landing Page Design & Build | MGL" description="Landing pages with one goal and one decision. For campaigns, launches, and paid traffic that needs somewhere focused to land." idPath="/layanan/jasa-landing-page" enPath="/en/services/landing-page-design" extraSchema={extraSchema}>
  <Fragment set:html={body} />
