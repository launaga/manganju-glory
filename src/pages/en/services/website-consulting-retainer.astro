import Base from '../../../layouts/Base.astro';
const body = "<section class=\"hero wrap\"> <div class=\"shead reveal\"> <div class=\"label\"><span class=\"eyebrow\">// Services</span><span class=\"folio\">01</span></div> </div> <h1 class=\"h1 reveal d1\" style=\"max-width:22ch;margin-top:18px;font-size:clamp(32px,4.4vw,60px)\">Website Consulting — A Senior Perspective Without a Full-Time Hire</h1> <p class=\"lead reveal d2\" style=\"margin-top:22px\">For founders and teams making expensive digital decisions with nobody independent to test them against.</p> <div class=\"reveal d3\" style=\"margin-top:32px;display:flex;gap:14px;flex-wrap:wrap\"> <a href=\"https://wa.me/6285927277560?text=Hi!%20I'd%20like%20to%20talk%20about%20an%20ongoing%20consulting%20arrangement...\" class=\"btn\" target=\"_blank\" rel=\"noopener\" data-wa=\"hero\" data-page=\"/en/services/website-consulting-retainer.html\"> Free Consultation<span class=\"arr\">↗</span> </a> <a href=\"/en/pricing\" class=\"btn ghost\">See pricing <span class=\"arr\">↗</span></a> </div> </section> <hr class=\"hair\" style=\"margin:0 var(--gut)\"> <section class=\"pad-sm wrap\"> <div class=\"shead reveal\"> <div class=\"label\"><span class=\"eyebrow\">// 02 — The problem</span><span class=\"folio\">02</span></div> </div> <div class=\"persp\"> <div class=\"reveal\"><p class=\"big\">Expensive digital decisions rarely look expensive when you make them.</p></div> <div class=\"reveal d1\"> <p class=\"lead\" style=\"margin-bottom:20px\">Choosing a platform. Approving an agency proposal. Deciding to build an app. Hiring a developer. Each looks like a small technical decision at the time, and only reveals itself two years later when you are locked into a system you cannot leave without rebuilding everything.</p><p class=\"lead\" style=\"margin-bottom:20px\">What is usually missing is not technical skill. It is someone with no incentive to sell you anything. Agencies are incentivised to recommend large projects. Platform vendors are incentivised to recommend their platform. Developers are incentivised to build.</p><p class=\"lead\" style=\"margin-bottom:20px\">That is where this sits. I am not selling you a project in this conversation — which is exactly what makes it useful. Often the best outcome of a session like this is deciding to build nothing yet.</p> </div> </div> </section> <hr class=\"hair\" style=\"margin:0 var(--gut)\"> <section class=\"pad-sm wrap\"> <div class=\"shead reveal\"> <div class=\"label\"> <div><span class=\"eyebrow\">// 03 — What's included</span><h2 class=\"h2\" style=\"margin-top:18px;max-width:20ch\">What you actually get.</h2></div> <span class=\"folio\">03</span> </div> </div> <div class=\"deflist reveal\"> <div><b>Regular sessions</b><p>An agreed rhythm to work through the decisions actually on your desk — not reports nobody reads.</p></div><div><b>Proposal &amp; vendor review</b><p>Reading agency or developer proposals with the eyes of someone who has been on that side.</p></div><div><b>Technical direction</b><p>Platform choices, architecture, and trade-offs explained in language you can make business decisions with.</p></div><div><b>Maintenance</b><p>Updates, backups, monitoring, and small fixes — if nobody on your team owns it.</p></div><div><b>Access when needed</b><p>A direct line for questions too small to be a project but too expensive to guess at.</p></div> </div> </section> <section class=\"pad-sm wrap\"> <div class=\"shead reveal\"> <div class=\"label\"> <div> <span class=\"eyebrow\">// 04 — Fit</span> <h2 class=\"h2\" style=\"margin-top:18px;max-width:22ch\">Who this is for — and who it isn't.</h2> <p class=\"lead\" style=\"margin-top:16px;max-width:62ch\">The right column matters as much as the left. I would rather lose the project here than have us both discover it in week five.</p> </div> <span class=\"folio\">04</span> </div> </div> <div class=\"fit-grid reveal\"> <div class=\"fit yes\"><b>A good fit if</b><ul><li>Founders making digital decisions with no technical person on the team.</li><li>Organisations running several sites that need consistency.</li><li>Teams evaluating an agency who want a disinterested opinion.</li><li>Businesses whose site runs but nobody truly owns.</li></ul></div> <div class=\"fit no\"><b>Not a fit if</b><ul><li>You need one project delivered and then nothing. Take the project service instead.</li><li>You want someone to approve a decision already made. You will be disappointed.</li><li>You need a full team executing. This is advisory, not an agency.</li><li>You want 24/7 support. I do not sell that, and anyone selling it to you cheaply is lying.</li></ul></div> </div> </section> <hr class=\"hair\" style=\"margin:0 var(--gut)\"> <section class=\"pad-sm wrap\"> <div class=\"shead reveal\"> <div class=\"label\"> <div> <span class=\"eyebrow\">// 05 — Process</span> <h2 class=\"h2\" style=\"margin-top:18px\">How this runs.</h2> <p class=\"lead\" style=\"margin-top:16px;max-width:62ch\">Ongoing, reviewed periodically. Not a contract that locks you in for years.</p> </div> <span class=\"folio\">05</span> </div> </div> <div class=\"proc\"> <div class=\"proc-step reveal\"><div class=\"pn\">1.</div><h3>Landscape mapping</h3><p>Understanding your digital estate today: what exists, who maintains it, what is breaking.</p></div><div class=\"proc-step reveal\"><div class=\"pn\">2.</div><h3>Prioritisation</h3><p>What is urgent, what is important, and what should not be done at all.</p></div><div class=\"proc-step reveal\"><div class=\"pn\">3.</div><h3>Regular rhythm</h3><p>Sessions follow the decisions in flight, not the calendar.</p></div><div class=\"proc-step reveal\"><div class=\"pn\">4.</div><h3>Review</h3><p>Reviewed periodically. If you no longer need this, I will say so.</p></div> </div> </section> <section class=\"pad-sm wrap\"> <div class=\"shead reveal\"> <div class=\"label\"> <div> <span class=\"eyebrow\">// 06 — Pricing</span> <h2 class=\"h2\" style=\"margin-top:18px\">By consultation</h2> <p class=\"lead\" style=\"margin-top:16px;max-width:62ch\">Depends on session rhythm and whether technical maintenance is included.</p> <div style=\"margin-top:26px\"><a href=\"/en/pricing\" class=\"btn ghost\">Full pricing &amp; what's excluded <span class=\"arr\">↗</span></a></div> </div> <span class=\"folio\">06</span> </div> </div> </section> <section class=\"pad-sm wrap\"> <div class=\"shead reveal\"> <div class=\"label\"> <div><span class=\"eyebrow\">// 07 — Examples</span><h2 class=\"h2\" style=\"margin-top:18px\">Comparable work.</h2></div> <span class=\"folio\">07</span> </div> </div> <div class=\"more-grid reveal\"> <a class=\"more-card\" href=\"https://jakartafeminist.com/\" target=\"_blank\" rel=\"noopener noreferrer\"> <div class=\"mthumb\"><img src=\"/img/work/jakarta-feminist.webp\" alt=\"Screenshot of the Jakarta Feminist project\" width=\"1200\" height=\"579\" loading=\"lazy\" decoding=\"async\"></div> <div class=\"mt\"><h3 class=\"h3\">Jakarta Feminist</h3><span class=\"mtag\">.Redesign .WordPress</span></div> <p>A feminist organisation strengthening its advocacy. I consolidated editorial content, events, and resources into a single mobilisation hub — migrating from Wix Editor to WordPress, supporting Women&#39;s March Jakarta, FemFest, and more.</p> <span class=\"open\">View site ↗</span> </a><a class=\"more-card\" href=\"https://www.thearisefoundation.com/\" target=\"_blank\" rel=\"noopener noreferrer\"> <div class=\"mthumb\"><img src=\"/img/work/the-arise-foundation.webp\" alt=\"Screenshot of the The Arise Foundation project\" width=\"945\" height=\"816\" loading=\"lazy\" decoding=\"async\"></div> <div class=\"mt\"><h3 class=\"h3\">The Arise Foundation</h3><span class=\"mtag\">.Wix Studio .Gamify</span></div> <p>A youth-driven initiative in Tanzania. The challenge: a gamified quiz for students. I told their impact story through specific outcomes — 1,300 lunches a day, 100 laptops — turning a sense of connection into donor action.</p> <span class=\"open\">View site ↗</span> </a> </div> <p class=\"lead\" style=\"margin-top:24px;font-size:15px\"> <a href=\"/en/work\" style=\"text-decoration:underline;text-underline-offset:4px\">See the full portfolio</a> — with the reasoning behind each decision.\n</p> </section> <hr class=\"hair\" style=\"margin:0 var(--gut)\"> <section class=\"pad-sm wrap\"> <div class=\"shead reveal\"> <div class=\"label\"> <div><span class=\"eyebrow\">// 08 — Questions</span><h2 class=\"h2\" style=\"margin-top:18px\">What people usually ask.</h2></div> <span class=\"folio\">08</span> </div> </div> <div class=\"faq reveal\"> <details> <summary><span class=\"fq\">/01</span>How is this different from hiring an agency?</summary> <p class=\"fa\">An agency is paid to execute, so the incentive always bends toward something being built. I am paid to help you decide, including deciding to do nothing. The two coexist — some clients use me specifically to evaluate their agency&#39;s work.</p> </details><details> <summary><span class=\"fq\">/02</span>Does this include making changes to the site?</summary> <p class=\"fa\">Small fixes and routine maintenance can be included. Larger changes or new features are separate projects with their own scope and price. I keep that boundary deliberately clear, so a retainer does not quietly turn into an unbounded work queue.</p> </details><details> <summary><span class=\"fq\">/03</span>How long is the commitment?</summary> <p class=\"fa\">Ongoing with periodic review, and not designed to lock you in. If your situation is stable and there are no big decisions ahead, I will tell you that you no longer need this. A client paying for something they have outgrown is not a good client for anyone.</p> </details> </div> </section> <section class=\"cta-ink pad\"> <img class=\"bgimg\" src=\"/img/cta-bg.webp\" width=\"1440\" height=\"1024\" loading=\"lazy\" decoding=\"async\" alt=\"\" aria-hidden=\"true\"> <div class=\"wrap\" style=\"position:relative\"> <span class=\"eyebrow reveal\">// Let's talk</span> <h2 class=\"h2 reveal d1\" style=\"margin:24px 0 36px;max-width:20ch\">Sounds like a fit? Let's test that first.</h2> <div class=\"reveal d2\"> <a href=\"https://wa.me/6285927277560?text=Hi!%20I'd%20like%20to%20talk%20about%20an%20ongoing%20consulting%20arrangement...\" class=\"btn on-ink\" target=\"_blank\" rel=\"noopener\" data-wa=\"cta\" data-page=\"/en/services/website-consulting-retainer.html\"> Free Consultation<span class=\"arr\">↗</span> </a> </div> </div> </section>";
const extraSchema = [{"@type":"Service","name":"website consultant","description":"A senior perspective on digital decisions without hiring a full-time digital director. Vendor review, technical direction, and maintenance.","url":"https://mglportfolio.vercel.app/en/services/website-consulting-retainer","serviceType":"Consulting Retainer","provider":{"@id":"https://mglportfolio.vercel.app/#service"},"areaServed":{"@type":"Country","name":"Indonesia"},"inLanguage":"en-US"},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://mglportfolio.vercel.app/en"},{"@type":"ListItem","position":2,"name":"Services","item":"https://mglportfolio.vercel.app/en/services"},{"@type":"ListItem","position":3,"name":"Consulting Retainer","item":"https://mglportfolio.vercel.app/en/services/website-consulting-retainer"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How is this different from hiring an agency?","acceptedAnswer":{"@type":"Answer","text":"An agency is paid to execute, so the incentive always bends toward something being built. I am paid to help you decide, including deciding to do nothing. The two coexist — some clients use me specifically to evaluate their agency's work."}},{"@type":"Question","name":"Does this include making changes to the site?","acceptedAnswer":{"@type":"Answer","text":"Small fixes and routine maintenance can be included. Larger changes or new features are separate projects with their own scope and price. I keep that boundary deliberately clear, so a retainer does not quietly turn into an unbounded work queue."}},{"@type":"Question","name":"How long is the commitment?","acceptedAnswer":{"@type":"Answer","text":"Ongoing with periodic review, and not designed to lock you in. If your situation is stable and there are no big decisions ahead, I will tell you that you no longer need this. A client paying for something they have outgrown is not a good client for anyone."}}]}];
