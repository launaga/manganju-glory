<Base lang="en" title="E-Commerce Website Development | MGL" description="E-commerce builds designed to be run, not just launched. Catalogue architecture first, storefront second." idPath="/layanan/jasa-pembuatan-website-ecommerce" enPath="/en/services/ecommerce-website" extraSchema={extraSchema}>
