---
import Base from '../../layouts/Base.astro';
import ContactBody from '../../components/ContactBody.astro';
import seo from '../../data/seo/contact.json';

const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://haloglory.com/en' },
    { '@type': 'ListItem', position: 2, name: 'Contact', item: 'https://haloglory.com/en/contact' },
  ],
};
---

<Base
  lang="en"
  title={seo.title_en}
  description={seo.desc_en}
  image={seo.ogImage}
  idPath="/kontak"
  enPath="/en/contact"
  extraSchema={[breadcrumb]}
>
  <ContactBody lang="en" />
</Base>
