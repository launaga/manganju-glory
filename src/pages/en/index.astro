---
import Base from '../../layouts/Base.astro';
import StatsBlock from '../../components/StatsBlock.astro';
import { WA_EN } from '../../data/site';
import seo from '../../data/seo/home.json';
---

<Base
  lang="en"
  title={seo.title_en}
  description={seo.desc_en}
  image={seo.ogImage}
  idPath="/"
  enPath="/en"
>
  <main id="page-home-en" class="page">
    <!-- HERO -->
    <section class="hero wrap">
      <div class="hero-grid">
        <div class="hero-meta">
          <span class="eyebrow reveal">// Independent Website Consultant</span>
          <h1 class="h1 reveal d1">
            <span class="line"><span class="ln">I build websites</span></span>
            <span class="line"><span class="ln">that make businesses</span></span>
            <span class="line"><span class="ln"><span class="u-accent">easier to understand.</span></span></span>
          </h1>
          <p class="lead reveal d2" style="font-family:var(--mono);font-size:14px;letter-spacing:.04em;color:var(--ink-soft);text-transform:uppercase">Consultant · Designer · Developer</p>
          <p class="lead reveal d2">Most websites make a business look smaller than it is. Visitors drown in feature lists, the actual message hides behind whatever is fashionable, and the owner cannot work out why nothing converts. That is what I fix — turning your expertise into <span class="mark">instant clarity</span>, so the right people grasp your value in thirty seconds.</p>
          <div class="reveal d3"><a href={WA_EN} class="btn" target="_blank" rel="noopener" data-wa="hero" data-page="/en">
            Free Consultation<span class="arr">↗</span>
          </a></div>
        </div>
        <div class="hero-photo reveal d2">
          <img src="/img/portrait-mgl.webp" alt="Manganju Glory Laurencius, website consultant and designer" width="1000" height="1500" fetchpriority="high" decoding="async" />
          <span class="cap">Fig. 01 — M.G. Laurencius</span>
        </div>
      </div>
    </section>

    <!-- marquee -->
    <div class="marquee ink" style="margin-top:clamp(60px,8vw,110px)" aria-hidden="true">
      <div class="marquee-track">
        <span>WordPress Development</span><span>Figma Design</span><span>Wix Studio Expert</span>
        <span>WordPress Development</span><span>Figma Design</span><span>Wix Studio Expert</span>
        <span>WordPress Development</span><span>Figma Design</span><span>Wix Studio Expert</span>
      </div>
    </div>

    <!-- A DIFFERENT ANGLE -->
    <section class="pad wrap">
      <div class="shead reveal">
        <div class="label">
          <span class="eyebrow">// 02 — A Different Angle</span>
          <span class="folio">02</span>
        </div>
      </div>
      <div class="persp">
        <div class="reveal">
          <p class="big">Most website projects start in <span class="u-accent">the wrong place.</span></p>
        </div>
        <div class="reveal d1">
          <p class="lead" style="margin-bottom:24px">Plenty of businesses come to me asking for a redesign. Twenty minutes into the conversation, we usually find the actual problem: they have not yet worked out how to explain what they do.</p>
          <p class="clears">Clear <b>positioning</b>.<br>Clear <b>message</b>.<br>Clear <b>priorities</b>.</p>
          <p class="lead" style="margin:24px 0">A website gets dramatically stronger once that foundation is understood. That is where every project of mine begins. Not with a colour palette. With clarity.</p>
          <p class="lead" style="font-family:var(--disp);font-weight:700;color:var(--ink);font-size:clamp(19px,2vw,26px);line-height:1.2">Good websites are not built out of pages. They are built out of <span class="mark">clarity.</span></p>
        </div>
      </div>
    </section>
    <hr class="hair">

    <!-- EXPERTISE -->
    <section class="pad wrap">
      <div class="shead reveal">
        <div class="label">
          <div>
            <span class="eyebrow">// 03 — Expertise · What I Bring</span>
            <h2 class="h2" style="margin-top:20px;max-width:18ch">Strategy, design, and development working together.</h2>
          </div>
          <span class="folio">03</span>
        </div>
      </div>
      <div class="exp-grid">
        <div class="exp-col reveal">
          <span class="n">/STRATEGY</span>
          <h3 class="h3">Strategy</h3>
          <p>Understanding goals, audience, structure, and opportunities before making a single design decision.</p>
          <ul class="tags">
            <li>Discovery Workshop</li><li>Website Planning</li><li>Information Architecture</li><li>User Journey Mapping</li><li>Content Strategy</li>
          </ul>
        </div>
        <div class="exp-col reveal d1">
          <span class="n">/DESIGN</span>
          <h3 class="h3">Design</h3>
          <p>Creating experiences that communicate clearly and build confidence, not just look impressive.</p>
          <ul class="tags">
            <li>Wireframing</li><li>Interface Design</li><li>Responsive Design</li><li>Design System</li><li>Conversion-Oriented Layout</li>
          </ul>
        </div>
        <div class="exp-col reveal d2">
          <span class="n">/DEVELOPMENT</span>
          <h3 class="h3">Development</h3>
          <p>Building scalable websites that are easy to manage, load fast, and ready to grow.</p>
          <ul class="tags">
            <li>WordPress</li><li>Wix</li><li>Elementor</li><li>Custom Integrations</li><li>Performance Optimisation</li>
          </ul>
        </div>
      </div>
    </section>
    <hr class="hair">

    <!-- ABOUT TEASER -->
    <section class="pad wrap">
      <div class="shead reveal"><div class="label"><span class="eyebrow">// 04 — About</span><span class="folio">04</span></div></div>
      <div class="teaser">
        <div class="reveal">
          <h2 class="h2" style="max-width:16ch">I don't just build websites. I help people make <span class="u-accent">better digital decisions.</span></h2>
        </div>
        <div class="reveal d1">
          <p class="lead" style="margin-bottom:24px">Over the years I've worked with businesses, organisations, and professionals across many industries. The projects differ. The challenge is often the same: turning expertise, ideas, and ambition into something people understand instantly.</p>
          <a href="/en/about" class="btn ghost">More about me <span class="arr">↗</span></a>
        </div>
      </div>
    </section>

    <!-- STATS -->
    <section class="pad-sm wrap">
      <StatsBlock lang="en" />
    </section>

    <!-- SERVICES -->
    <section class="pad wrap">
      <div class="shead reveal">
        <div class="label">
          <div>
            <span class="eyebrow">// 05 — Services</span>
            <h2 class="h2" style="margin-top:20px;max-width:16ch">Support designed for every stage of growth.</h2>
          </div>
          <span class="folio">05</span>
        </div>
      </div>
      <div class="svc">
        <div class="svc-row reveal">
          <div class="ico">*</div>
          <div class="ttl"><h3 class="h3">WordPress Development</h3><p>Flexible websites designed for full ownership, scalability, and long-term growth.</p></div>
          <div class="best"><b>Best for</b>Businesses that want to manage their own content without contacting a developer for every change.</div>
        </div>
        <div class="svc-row reveal d1">
          <div class="ico">**</div>
          <div class="ttl"><h3 class="h3">Wix Design &amp; Development</h3><p>From discovery and planning through to design, development, and launch.</p></div>
          <div class="best"><b>Best for</b>Businesses building a new website, or replacing one that no longer fits.</div>
        </div>
        <div class="svc-row reveal d2">
          <div class="ico">***</div>
          <div class="ttl"><h3 class="h3">Long-Term Partnership</h3><p>Strategic guidance and ongoing support for businesses making important digital decisions.</p></div>
          <div class="best"><b>Best for</b>Founders and teams who need a senior perspective without hiring a full-time digital director.</div>
        </div>
      </div>
    </section>
    <hr class="hair">

    <!-- PROCESS -->
    <section class="pad wrap">
      <div class="shead reveal">
        <div class="label">
          <div>
            <span class="eyebrow">// 06 — Process</span>
            <h2 class="h2" style="margin-top:20px">A simple process. Clear expectations.</h2>
            <p class="lead" style="margin-top:18px">Every project goes through the same stages. You'll always know where we are, what's next, and what you need to prepare at each step.</p>
          </div>
          <span class="folio">06</span>
        </div>
      </div>
      <div class="proc">
        <div class="proc-step reveal"><div class="pn">1.</div><h3>Discovery &amp; Diagnosis</h3><p>Understanding the business, its challenges, and its opportunities. What you get: a clear project scope, timeline, and an honest assessment of what's realistic.</p></div>
        <div class="proc-step reveal d1"><div class="pn">2.</div><h3>Design &amp; Development</h3><p>Designing and building the solution. What you get: regular updates, room for feedback, and no surprises at launch.</p></div>
        <div class="proc-step reveal d2"><div class="pn">3.</div><h3>Launch &amp; Growth</h3><p>Supporting long-term success after launch. What you get: a site that works on day one, and a plan for day one hundred.</p></div>
        <div class="proc-step reveal d3"><div class="pn">4.</div><h3>Timeline Transparency</h3><p>Projects typically run 4–12 weeks depending on complexity. No mystery, no shifting targets.</p></div>
      </div>
    </section>

    <!-- marquee accent -->
    <div class="marquee accent" aria-hidden="true">
      <div class="marquee-track">
        <span>Strategy</span><span>Design</span><span>Development</span><span>Consulting</span><span>Problem Solving</span><span>User Experience</span><span>Digital Products</span>
        <span>Strategy</span><span>Design</span><span>Development</span><span>Consulting</span><span>Problem Solving</span><span>User Experience</span><span>Digital Products</span>
      </div>
    </div>

    <!-- CLOSING CTA -->
    <section class="cta-ink pad">
      <img class="bgimg" src="/img/cta-bg.webp" width="1440" height="1024" loading="lazy" decoding="async" alt="" aria-hidden="true" />
      <div class="wrap" style="position:relative">
        <span class="eyebrow reveal">// Let's talk</span>
        <h2 class="h2 reveal d1" style="margin:24px 0 36px">Interested in working together?</h2>
        <div class="reveal d2"><a href={WA_EN} class="btn on-ink" target="_blank" rel="noopener" data-wa="cta" data-page="/en">
          Free Consultation<span class="arr">↗</span>
        </a></div>
      </div>
    </section>
  </main>
</Base>
