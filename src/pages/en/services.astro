---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import seo from '../../data/seo/services.json';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const waHero = "https://wa.me/6285927277560?text=Hi!%20I'd%20like%20to%20discuss%20which%20service%20fits%20my%20needs...";

const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://mglportfolio.vercel.app/en' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://mglportfolio.vercel.app/en/services' },
  ],
};
---

<Base
  lang="en"
  title={seo.title_en}
  description={seo.desc_en}
  image={seo.ogImage}
  idPath="/layanan"
  enPath="/en/services"
  extraSchema={[breadcrumb]}
>
  <main id="page-services-en" class="page">
    <section class="hero wrap">
      <div class="shead reveal">
        <div class="label"><span class="eyebrow">// Services</span><span class="folio">01</span></div>
      </div>
      <h1 class="h1 reveal d1" style="max-width:16ch;margin-top:18px">Website services, <span class="u-accent">starting from strategy.</span></h1>
      <p class="lead reveal d2" style="margin-top:22px">Five ways I work with businesses and organisations. They all start in the same place — understanding the problem first — and differ only in how far I take the execution.</p>
      <div class="reveal d3" style="margin-top:32px;display:flex;gap:14px;flex-wrap:wrap">
        <a href={waHero} class="btn" target="_blank" rel="noopener" data-wa="hero" data-page="/en/services">Free Consultation<span class="arr">↗</span></a>
        <a href="/en/contact" class="btn ghost">Contact me <span class="arr">↗</span></a>
      </div>
    </section>
    <hr class="hair" style="margin:0 var(--gut)">

    <section class="pad-sm wrap">
      <div class="shead reveal">
        <div class="label">
          <div>
            <span class="eyebrow">// 02 — Options</span>
            <h2 class="h2" style="margin-top:18px;max-width:20ch">Choose by the problem, not the name.</h2>
            <p class="lead" style="margin-top:16px;max-width:62ch">If you're unsure which one, take the free consultation and let me help you choose. Including the chance I tell you that you don't need any of these yet.</p>
          </div>
          <span class="folio">02</span>
        </div>
      </div>
      <div class="svc-hub">
        {services.map((s) => (
          <a class="svc-hub-card" href={`/en/services/${s.data.slug_en}`}>
            <span class="n">{s.data.n_en}</span>
            <h3>{s.data.h_en}</h3>
            <p>{s.data.p_en}</p>
            <span class="meta">{s.data.meta_en}</span>
            <span class="open">Read more ↗</span>
          </a>
        ))}
      </div>
    </section>
    <hr class="hair" style="margin:0 var(--gut)">

    <section class="pad-sm wrap">
      <div class="shead reveal">
        <div class="label">
          <div>
            <span class="eyebrow">// 03 — How it works</span>
            <h2 class="h2" style="margin-top:18px">One process, whatever the service.</h2>
            <p class="lead" style="margin-top:18px;max-width:62ch">Every project goes through the same stages. You'll always know where we are, what's next, and what you need to prepare.</p>
          </div>
          <span class="folio">03</span>
        </div>
      </div>
      <div class="proc">
        <div class="proc-step reveal"><div class="pn">1.</div><h3>Discovery &amp; Diagnosis</h3><p>Understanding the business, its challenges, and its opportunities. What you get: a clear scope, timeline, and an honest assessment of what's realistic.</p></div>
        <div class="proc-step reveal d1"><div class="pn">2.</div><h3>Design &amp; Development</h3><p>Designing and building the solution. What you get: regular updates, room for feedback, and no surprises at launch.</p></div>
        <div class="proc-step reveal d2"><div class="pn">3.</div><h3>Launch &amp; Growth</h3><p>Supporting long-term success after launch. What you get: a site that works on day one, and a plan for day one hundred.</p></div>
        <div class="proc-step reveal d3"><div class="pn">4.</div><h3>Timeline Transparency</h3><p>Projects typically run 4–12 weeks depending on complexity. No mystery, no shifting targets.</p></div>
      </div>
    </section>

    <div class="marquee accent" aria-hidden="true">
      <div class="marquee-track">
        <span>Strategy</span><span>Design</span><span>Development</span><span>Consulting</span><span>Problem Solving</span><span>User Experience</span><span>Digital Products</span>
        <span>Strategy</span><span>Design</span><span>Development</span><span>Consulting</span><span>Problem Solving</span><span>User Experience</span><span>Digital Products</span>
      </div>
    </div>

    <section class="cta-ink pad">
      <img class="bgimg" src="/img/cta-bg.webp" width="1440" height="1024" loading="lazy" decoding="async" alt="" aria-hidden="true" />
      <div class="wrap" style="position:relative">
        <span class="eyebrow reveal">// Let's talk</span>
        <h2 class="h2 reveal d1" style="margin:24px 0 36px">Not sure which one you need?</h2>
        <div class="reveal d2">
          <a href={waHero} class="btn on-ink" target="_blank" rel="noopener" data-wa="cta" data-page="/en/services">Free Consultation<span class="arr">↗</span></a>
        </div>
      </div>
    </section>
  </main>
</Base>
