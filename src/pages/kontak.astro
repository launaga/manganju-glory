---
import Base from '../layouts/Base.astro';
import ContactBody from '../components/ContactBody.astro';
import seo from '../data/seo/contact.json';

const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://haloglory.com/' },
    { '@type': 'ListItem', position: 2, name: 'Kontak', item: 'https://haloglory.com/kontak' },
  ],
};
---

<Base
  lang="id"
  title={seo.title_id}
  description={seo.desc_id}
  image={seo.ogImage}
  idPath="/kontak"
  enPath="/en/contact"
  extraSchema={[breadcrumb]}
>
  <ContactBody lang="id" />
</Base>
