---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import seo from '../data/seo/work.json';

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = all.filter((p) => p.data.featured);
const more = all.filter((p) => !p.data.featured);
const waCta = "https://wa.me/6285927277560?text=Hi!%20Saya%20lihat%20portofolio%20Anda%20dan%20ingin%20diskusi%20proyek%20serupa...";

const collectionSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://mglportfolio.vercel.app/' },
    { '@type': 'ListItem', position: 2, name: 'Portofolio', item: 'https://mglportfolio.vercel.app/portofolio' },
  ],
};
---

<Base
  lang="id"
  title={seo.title_id}
  description={seo.desc_id}
  image={seo.ogImage}
  idPath="/portofolio"
  enPath="/en/work"
  extraSchema={[collectionSchema]}
>
  <main id="page-portfolio" class="page">
    <section class="hero wrap" style="padding-top:clamp(120px,16vh,180px);padding-bottom:clamp(48px,6vw,96px)">
      <div class="shead reveal"><div class="label"><span class="eyebrow">// Portofolio</span><span class="folio">01</span></div></div>
      <h1 class="h1 reveal d1" style="max-width:14ch">Karya.</h1>
      <p class="lead reveal d2" style="margin-top:20px">Ini proyek-proyek tempat saya menyelesaikan masalah website yang nyata. Bagian paling menariknya selalu konteks di balik setiap keputusan — dan trade-off yang menyertainya.</p>
    </section>
    <hr class="hair" style="margin:0 var(--gut)">

    <section class="pad-sm wrap">
      <div class="shead reveal">
        <div class="label">
          <div><span class="eyebrow">// 02 — Karya Pilihan</span><h2 class="h2" style="margin-top:18px">Proyek unggulan.</h2><p class="lead" style="margin-top:16px;max-width:64ch">Kumpulan yang menunjukkan proses, cara berpikir, dan pendekatan saya dalam menyelesaikan tantangan digital. Ini bukan satu-satunya proyek saya — ini yang paling menggambarkan cara saya bekerja.</p></div>
          <span class="folio">02</span>
        </div>
      </div>
      <div class="proj" id="featuredList">
        {featured.map((p, i) => (
          <a class="proj-row" href={p.data.url} target="_blank" rel="noopener noreferrer" data-img={p.data.image}>
            <span class="pidx">/{String(i + 1).padStart(2, '0')}</span>
            <div class="pmain">
              <h3 class="h3">{p.data.name}</h3>
              <div class="ptags">{p.data.tags.map((t) => `.${t}`).join('  ')}</div>
            </div>
            <p class="pdesc">{p.data.desc_id}</p>
            <div class="pthumb">
              <img src={p.data.image} alt={p.data.alt_id} width={p.data.imageWidth} height={p.data.imageHeight} loading="lazy" decoding="async" />
            </div>
            <span class="ext">Kunjungi ↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="pad-sm wrap">
      <div class="shead reveal">
        <div class="label">
          <div><span class="eyebrow">// 03 — Lainnya</span><h2 class="h2" style="margin-top:18px">Proyek lainnya.</h2><p class="lead" style="margin-top:16px;max-width:60ch">Karya lain yang saya bangun selama bertahun-tahun — dari desain web dan eksplorasi desain hingga proyek open-source yang benar-benar dipakai.</p></div>
          <span class="folio">03</span>
        </div>
      </div>
      <div class="more-grid reveal" id="moreList">
        {more.map((p) => (
          <a class="more-card" href={p.data.url} target="_blank" rel="noopener noreferrer">
            <div class="mthumb">
              <img src={p.data.image} alt={p.data.alt_id} width={p.data.imageWidth} height={p.data.imageHeight} loading="lazy" decoding="async" />
            </div>
            <div class="mt">
              <h3 class="h3">{p.data.name}</h3>
              <span class="mtag">{p.data.tags.map((t) => `.${t}`).join(' ')}</span>
            </div>
            <p>{p.data.desc_id}</p>
            <span class="open">Lihat situs ↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="pad-sm wrap">
      <div class="shead reveal">
        <div class="label">
          <div><span class="eyebrow">// 04 — Studi Kasus</span><h2 class="h2" style="margin-top:18px">Cerita di balik dua proyek.</h2><p class="lead" style="margin-top:16px;max-width:60ch">Grid di atas menunjukkan hasilnya. Dua halaman ini menunjukkan bagaimana keputusannya diambil — termasuk yang salah.</p></div>
          <span class="folio">04</span>
        </div>
      </div>
      <div class="svc-hub reveal">
        <a class="svc-hub-card" href="/portofolio/redesign-website-ngo-london">
          <span class="n">/01 — Redesign Website NGO London</span>
          <h3>Kenapa Website NGO Ini Gagal di Dua Agensi Sebelumnya</h3>
          <p>Sebuah NGO ternama di London sudah membakar anggaran di dua agensi. Keduanya menghasilkan situs yang indah. Tidak satu pun bekerja.</p>
          <span class="open">Baca studi kasus ↗</span>
        </a><a class="svc-hub-card" href="/portofolio/jakarta-feminist">
          <span class="n">/02 — Jakarta Feminist</span>
          <h3>Tiga Website, Lima Tahun: Apa yang Terjadi Kalau Klien Tidak Mau Fitur</h3>
          <p>Awalnya kontrak membangun tiga website. Berlanjut jadi pendampingan hampir lima tahun — dan mengubah cara saya menilai pekerjaan sendiri.</p>
          <span class="open">Baca studi kasus ↗</span>
        </a>
      </div>
    </section>

    <div class="marquee accent" aria-hidden="true">
      <div class="marquee-track">
        <span>Strategi</span><span>Desain</span><span>Pengembangan</span><span>Konsultasi</span><span>Problem Solving</span><span>User Experience</span><span>Produk Digital</span>
        <span>Strategi</span><span>Desain</span><span>Pengembangan</span><span>Konsultasi</span><span>Problem Solving</span><span>User Experience</span><span>Produk Digital</span>
      </div>
    </div>

    <section class="cta-ink pad">
      <img class="bgimg" src="/img/cta-bg.webp" width="1440" height="1024" loading="lazy" decoding="async" alt="" aria-hidden="true" />
      <div class="wrap" style="position:relative">
        <span class="eyebrow reveal">// Mari Bicara</span>
        <h2 class="h2 reveal d1" style="margin:24px 0 36px">Punya masalah yang layak diselesaikan?</h2>
        <div class="reveal d2"><a href={waCta} class="btn on-ink" target="_blank" rel="noopener" data-wa="cta" data-page="/portofolio">
          Konsultasi Gratis<span class="arr">↗</span>
        </a></div>
      </div>
    </section>
  </main>
</Base>
