import Base from '../layouts/Base.astro';
const body = "<section class=\"hero wrap\" style=\"padding-top:clamp(120px,16vh,180px);padding-bottom:clamp(48px,6vw,96px)\"> <div class=\"shead reveal\"><div class=\"label\"><span class=\"eyebrow\">// Portofolio</span><span class=\"folio\">01</span></div></div> <h1 class=\"h1 reveal d1\" style=\"max-width:14ch\">Karya.</h1> <p class=\"lead reveal d2\" style=\"margin-top:20px\">Ini proyek-proyek tempat saya menyelesaikan masalah website yang nyata. Bagian paling menariknya selalu konteks di balik setiap keputusan — dan trade-off yang menyertainya.</p> </section> <hr class=\"hair\" style=\"margin:0 var(--gut)\"> <section class=\"pad-sm wrap\"> <div class=\"shead reveal\"> <div class=\"label\"> <div><span class=\"eyebrow\">// 02 — Karya Pilihan</span><h2 class=\"h2\" style=\"margin-top:18px\">Proyek unggulan.</h2><p class=\"lead\" style=\"margin-top:16px;max-width:64ch\">Kumpulan yang menunjukkan proses, cara berpikir, dan pendekatan saya dalam menyelesaikan tantangan digital. Ini bukan satu-satunya proyek saya — ini yang paling menggambarkan cara saya bekerja.</p></div> <span class=\"folio\">02</span> </div> </div> <div class=\"proj\" id=\"featuredList\"> <a class=\"proj-row\" href=\"https://eyelevel-id.com/\" target=\"_blank\" rel=\"noopener noreferrer\" data-img=\"/img/work/eyelevel-id.webp\"> <span class=\"pidx\">/01</span> <div class=\"pmain\"> <h3 class=\"h3\">Eyelevel-id</h3> <div class=\"ptags\">.Creator  .WordPress</div> </div> <p class=\"pdesc\">Agensi digital marketing di Jakarta. Tantangannya: membangun kredibilitas tanpa terlihat seperti vendor kebanyakan. Saya terjemahkan design guideline mereka menjadi situs WordPress yang memposisikan mereka sebagai Google Partner strategis.</p> <div class=\"pthumb\"> <img src=\"/img/work/eyelevel-id.webp\" alt=\"Tangkapan layar proyek Eyelevel-id\" width=\"470\" height=\"557\" loading=\"lazy\" decoding=\"async\"> </div> <span class=\"ext\">Kunjungi ↗</span> </a><a class=\"proj-row\" href=\"https://www.addededucation.com/\" target=\"_blank\" rel=\"noopener noreferrer\" data-img=\"/img/work/addededucation.webp\"> <span class=\"pidx\">/02</span> <div class=\"pmain\"> <h3 class=\"h3\">AddedEducation</h3> <div class=\"ptags\">.Creator  .WordPress</div> </div> <p class=\"pdesc\">Konsultan pendidikan yang situs lamanya mengubur pesan utama di balik daftar fitur dan klise generik, membuat orang tua bingung apa yang membedakan mereka. Saya bangun ulang dengan bahasa orang tua — terasa premium, membuktikan kredibilitas lewat angka konkret sebelum keraguan sempat muncul.</p> <div class=\"pthumb\"> <img src=\"/img/work/addededucation.webp\" alt=\"Tangkapan layar proyek AddedEducation\" width=\"632\" height=\"637\" loading=\"lazy\" decoding=\"async\"> </div> <span class=\"ext\">Kunjungi ↗</span> </a><a class=\"proj-row\" href=\"https://ipasindonesia.org/\" target=\"_blank\" rel=\"noopener noreferrer\" data-img=\"/img/work/ipas-indonesia.webp\"> <span class=\"pidx\">/03</span> <div class=\"pmain\"> <h3 class=\"h3\">Ipas Indonesia</h3> <div class=\"ptags\">.Redesign  .WordPress</div> </div> <p class=\"pdesc\">NGO kesehatan reproduksi yang memperluas akses layanan pascakeguguran yang aman. Situs lama mereka menyimpang dari design system internasional yang baru. Saya bangun ulang agar selaras dengan brand global, tanpa mengorbankan preferensi audiens Indonesia.</p> <div class=\"pthumb\"> <img src=\"/img/work/ipas-indonesia.webp\" alt=\"Tangkapan layar proyek Ipas Indonesia\" width=\"947\" height=\"857\" loading=\"lazy\" decoding=\"async\"> </div> <span class=\"ext\">Kunjungi ↗</span> </a><a class=\"proj-row\" href=\"https://jakartafeminist.com/\" target=\"_blank\" rel=\"noopener noreferrer\" data-img=\"/img/work/jakarta-feminist.webp\"> <span class=\"pidx\">/04</span> <div class=\"pmain\"> <h3 class=\"h3\">Jakarta Feminist</h3> <div class=\"ptags\">.Redesign  .WordPress</div> </div> <p class=\"pdesc\">Organisasi feminis yang memperkuat advokasi. Saya satukan konten editorial, acara, dan sumber daya menjadi satu pusat mobilisasi — migrasi dari Wix Editor ke WordPress, menopang Women&#39;s March Jakarta, FemFest, dan lainnya.</p> <div class=\"pthumb\"> <img src=\"/img/work/jakarta-feminist.webp\" alt=\"Tangkapan layar proyek Jakarta Feminist\" width=\"1200\" height=\"579\" loading=\"lazy\" decoding=\"async\"> </div> <span class=\"ext\">Kunjungi ↗</span> </a><a class=\"proj-row\" href=\"https://carilayanan.com/\" target=\"_blank\" rel=\"noopener noreferrer\" data-img=\"/img/work/cari-layanan.webp\"> <span class=\"pidx\">/05</span> <div class=\"pmain\"> <h3 class=\"h3\">Cari Layanan</h3> <div class=\"ptags\">.WordPress</div> </div> <p class=\"pdesc\">Direktori krisis untuk penyintas kekerasan berbasis gender selama COVID-19. Saya bangun direktori WordPress yang memetakan layanan terverifikasi berdasarkan lokasi dan kebutuhan — rahasia, langsung bisa diakses, dan menskala hingga ribuan pengguna.</p> <div class=\"pthumb\"> <img src=\"/img/work/cari-layanan.webp\" alt=\"Tangkapan layar proyek Cari Layanan\" width=\"861\" height=\"822\" loading=\"lazy\" decoding=\"async\"> </div> <span class=\"ext\">Kunjungi ↗</span> </a><a class=\"proj-row\" href=\"https://www.thearisefoundation.com/\" target=\"_blank\" rel=\"noopener noreferrer\" data-img=\"/img/work/the-arise-foundation.webp\"> <span class=\"pidx\">/06</span> <div class=\"pmain\"> <h3 class=\"h3\">The Arise Foundation</h3> <div class=\"ptags\">.Wix Studio  .Gamify</div> </div> <p class=\"pdesc\">Inisiatif yang digerakkan anak muda di Tanzania. Tantangannya: kuis gamifikasi untuk pelajar. Saya ceritakan dampak mereka lewat hasil yang spesifik — 1.300 makan siang per hari, 100 laptop — mengubah rasa terhubung menjadi aksi donasi.</p> <div class=\"pthumb\"> <img src=\"/img/work/the-arise-foundation.webp\" alt=\"Tangkapan layar proyek The Arise Foundation\" width=\"945\" height=\"816\" loading=\"lazy\" decoding=\"async\"> </div> <span class=\"ext\">Kunjungi ↗</span> </a><a class=\"proj-row\" href=\"https://www.projectnamboudik.com/\" target=\"_blank\" rel=\"noopener noreferrer\" data-img=\"/img/work/project-nambo-udik.webp\"> <span class=\"pidx\">/07</span> <div class=\"pmain\"> <h3 class=\"h3\">Project Nambo Udik</h3> <div class=\"ptags\">.Wix Studio</div> </div> <p class=\"pdesc\">Proyek komunitas yang meningkatkan literasi dan kesehatan anak-anak di pedesaan Indonesia. Saya bangun situs Wix Studio yang mendokumentasikan“Revolusi Membaca” dan Sports Day mereka — transparansi yang membangun kepercayaan donor.</p> <div class=\"pthumb\"> <img src=\"/img/work/project-nambo-udik.webp\" alt=\"Tangkapan layar proyek Project Nambo Udik\" width=\"937\" height=\"822\" loading=\"lazy\" decoding=\"async\"> </div> <span class=\"ext\">Kunjungi ↗</span> </a><a class=\"proj-row\" href=\"https://www.supportspace.online/\" target=\"_blank\" rel=\"noopener noreferrer\" data-img=\"/img/work/support-space.webp\"> <span class=\"pidx\">/08</span> <div class=\"pmain\"> <h3 class=\"h3\">Support Space</h3> <div class=\"ptags\">.Wix Studio</div> </div> <p class=\"pdesc\">Platform untuk seorang profesional kesehatan mental. Tantangannya: membangun kepercayaan tanpa kesan klinis yang dingin. Saya rancang pengalaman Wix Studio yang intim, menyeimbangkan kehangatan dan profesionalisme agar orang berani mengambil langkah pertama.</p> <div class=\"pthumb\"> <img src=\"/img/work/support-space.webp\" alt=\"Tangkapan layar proyek Support Space\" width=\"937\" height=\"817\" loading=\"lazy\" decoding=\"async\"> </div> <span class=\"ext\">Kunjungi ↗</span> </a><a class=\"proj-row\" href=\"https://www.nikhilbohra.com/\" target=\"_blank\" rel=\"noopener noreferrer\" data-img=\"/img/work/nikhil-bohra.webp\"> <span class=\"pidx\">/09</span> <div class=\"pmain\"> <h3 class=\"h3\">Nikhil Bohra</h3> <div class=\"ptags\">.Wix Editor</div> </div> <p class=\"pdesc\">Pusat informasi untuk pembalap Indian-American di Formula Regional European Championship. Saya rangkai perjalanannya dari Italian F4 hingga podium FRECA — narasi karier yang menandakan kesiapan untuk investasi sponsor.</p> <div class=\"pthumb\"> <img src=\"/img/work/nikhil-bohra.webp\" alt=\"Tangkapan layar proyek Nikhil Bohra\" width=\"941\" height=\"832\" loading=\"lazy\" decoding=\"async\"> </div> <span class=\"ext\">Kunjungi ↗</span> </a><a class=\"proj-row\" href=\"https://farmfreshbites.wixstudio.com/farm-fresh-bites\" target=\"_blank\" rel=\"noopener noreferrer\" data-img=\"/img/work/farm-fresh-bites.webp\"> <span class=\"pidx\">/10</span> <div class=\"pmain\"> <h3 class=\"h3\">Farm Fresh Bites</h3> <div class=\"ptags\">.Wix Studio  .eCommerce</div> </div> <p class=\"pdesc\">Usaha hyperlocal di Mumbai yang mengantarkan buah eksotis bersumber bertanggung jawab. Tantangannya: menjual produk premium sambil menonjolkan misi sosial yang nyata. Saya bangun etalase Wix Studio yang menyatukan toko, cerita pendiri, dan CSR — pendapatan vendor dan makanan yang didonasikan — sehingga setiap pembelian punya makna.</p> <div class=\"pthumb\"> <img src=\"/img/work/farm-fresh-bites.webp\" alt=\"Tangkapan layar proyek Farm Fresh Bites\" width=\"1145\" height=\"750\" loading=\"lazy\" decoding=\"async\"> </div> <span class=\"ext\">Kunjungi ↗</span> </a> </div> </section> <section class=\"pad-sm wrap\"> <div class=\"shead reveal\"> <div class=\"label\"> <div><span class=\"eyebrow\">// 03 — Lainnya</span><h2 class=\"h2\" style=\"margin-top:18px\">Proyek lainnya.</h2><p class=\"lead\" style=\"margin-top:16px;max-width:60ch\">Karya lain yang saya bangun selama bertahun-tahun — dari desain web dan eksplorasi desain hingga proyek open-source yang benar-benar dipakai.</p></div> <span class=\"folio\">03</span> </div> </div> <div class=\"more-grid reveal\" id=\"moreList\"> <a class=\"more-card\" href=\"https://credithealth.vercel.app/\" target=\"_blank\" rel=\"noopener noreferrer\"> <div class=\"mthumb\"> <img src=\"/img/work/credit-health.webp\" alt=\"Tangkapan layar proyek Credit Health\" width=\"1200\" height=\"675\" loading=\"lazy\" decoding=\"async\"> </div> <div class=\"mt\"> <h3 class=\"h3\">Credit Health</h3> <span class=\"mtag\">.Creator .Vercel .GitHub</span> </div> <p>Dibangun karena hampir semua tool keuangan pribadi yang layak memasang tarif $99–109/tahun dan mengunci fitur dasar di balik paywall. Saya ingin membuktikan dashboard finansial berfitur lengkap bisa dibangun dan dibagikan gratis.</p> <span class=\"open\">Lihat situs ↗</span> </a><a class=\"more-card\" href=\"https://dashboard-gilt-six-hkvkubuygh.vercel.app/\" target=\"_blank\" rel=\"noopener noreferrer\"> <div class=\"mthumb\"> <img src=\"/img/work/spotless-web-app.webp\" alt=\"Tangkapan layar proyek Spotless Web App\" width=\"1200\" height=\"580\" loading=\"lazy\" decoding=\"async\"> </div> <div class=\"mt\"> <h3 class=\"h3\">Spotless Web App</h3> <span class=\"mtag\">.Creator .Vercel .GitHub</span> </div> <p>Sistem manajemen SaaS 3 portal yang menopang ekosistem cuci mobil Spotless. React 19 + TypeScript + Recharts, dengan antarmuka POS real-time, manajemen keranjang, dan multi-pembayaran (Tunai, Debit, QRIS).</p> <span class=\"open\">Lihat situs ↗</span> </a><a class=\"more-card\" href=\"https://app-eight-phi-12.vercel.app/\" target=\"_blank\" rel=\"noopener noreferrer\"> <div class=\"mthumb\"> <img src=\"/img/work/spotless-mobile-app.webp\" alt=\"Tangkapan layar proyek Spotless Mobile App\" width=\"537\" height=\"922\" loading=\"lazy\" decoding=\"async\"> </div> <div class=\"mt\"> <h3 class=\"h3\">Spotless Mobile App</h3> <span class=\"mtag\">.Creator .Vercel</span> </div> <p>Aplikasi mobile cuci mobil premium yang dibayangkan ulang dari Karcher. React 19 + TypeScript, terasa native — 30+ layar: onboarding, pencarian merchant dengan peta, booking dengan add-on, dompet token, QR, dan 10 metode pembayaran.</p> <span class=\"open\">Lihat situs ↗</span> </a><a class=\"more-card\" href=\"https://dashboard-gilt-six-hkvkubuygh.vercel.app/\" target=\"_blank\" rel=\"noopener noreferrer\"> <div class=\"mthumb\"> <img src=\"/img/work/spotless-pos.webp\" alt=\"Tangkapan layar proyek Spotless POS\" width=\"1200\" height=\"529\" loading=\"lazy\" decoding=\"async\"> </div> <div class=\"mt\"> <h3 class=\"h3\">Spotless POS</h3> <span class=\"mtag\">.Creator .Vercel</span> </div> <p>Antarmuka kasir point-of-sale berfitur lengkap untuk operasional cuci mobil premium. Tata letak split-screen dengan grid produk 3 kolom (Self Service, Rollover, Automatic, Detailing, Add-on) dan panel tagihan real-time.</p> <span class=\"open\">Lihat situs ↗</span> </a><a class=\"more-card\" href=\"https://indycar-fleet-hub.lovable.app/\" target=\"_blank\" rel=\"noopener noreferrer\"> <div class=\"mthumb\"> <img src=\"/img/work/nusantara-rent.webp\" alt=\"Tangkapan layar proyek Nusantara Rent\" width=\"1200\" height=\"555\" loading=\"lazy\" decoding=\"async\"> </div> <div class=\"mt\"> <h3 class=\"h3\">Nusantara Rent</h3> <span class=\"mtag\">.Creator .Lovable</span> </div> <p>Rental mobil dengan driver yang beroperasi lintas kota. Tantangannya: rentang armada dari Avanza keluarga sampai Alphard tamu VVIP harus terbaca dalam satu layar tanpa membuat calon penyewa merasa salah alamat. Saya susun hierarki gelap-keemasan yang menaruh kapasitas dan harga di muka, lalu memangkas jalur booking menjadi satu langkah ke WhatsApp.</p> <span class=\"open\">Lihat situs ↗</span> </a><a class=\"more-card\" href=\"https://rasa-lokal-sentuh-asia.lovable.app/\" target=\"_blank\" rel=\"noopener noreferrer\"> <div class=\"mthumb\"> <img src=\"/img/work/rasalokal.webp\" alt=\"Tangkapan layar proyek Rasalokal\" width=\"1200\" height=\"575\" loading=\"lazy\" decoding=\"async\"> </div> <div class=\"mt\"> <h3 class=\"h3\">Rasalokal</h3> <span class=\"mtag\">.Creator .Lovable</span> </div> <p>Platform yang menghubungkan produsen camilan UMKM dengan distribusi modern dan marketplace. Masalahnya klasik di kategori ini: cerita &quot;dari dapur rumah&quot; gampang terdengar sentimental sampai produknya sendiri tidak terlihat serius. Saya pisahkan dua audiens yang selama ini bertabrakan — konsumen ritel dan pembeli B2B — sejak dari navigasi.</p> <span class=\"open\">Lihat situs ↗</span> </a> </div> </section> <section class=\"pad-sm wrap\"> <div class=\"shead reveal\"> <div class=\"label\"> <div><span class=\"eyebrow\">// 04 — Studi Kasus</span><h2 class=\"h2\" style=\"margin-top:18px\">Cerita di balik dua proyek.</h2><p class=\"lead\" style=\"margin-top:16px;max-width:60ch\">Grid di atas menunjukkan hasilnya. Dua halaman ini menunjukkan bagaimana keputusannya diambil — termasuk yang salah.</p></div> <span class=\"folio\">04</span> </div> </div> <div class=\"svc-hub reveal\"> <a class=\"svc-hub-card\" href=\"/portofolio/redesign-website-ngo-london\"> <span class=\"n\">/01 — Redesign Website NGO London</span> <h3>Kenapa Website NGO Ini Gagal di Dua Agensi Sebelumnya</h3> <p>Sebuah NGO ternama di London sudah membakar anggaran di dua agensi. Keduanya menghasilkan situs yang indah. Tidak satu pun bekerja.</p> <span class=\"open\">Baca studi kasus ↗</span> </a><a class=\"svc-hub-card\" href=\"/portofolio/jakarta-feminist\"> <span class=\"n\">/02 — Jakarta Feminist</span> <h3>Tiga Website, Lima Tahun: Apa yang Terjadi Kalau Klien Tidak Mau Fitur</h3> <p>Awalnya kontrak membangun tiga website. Berlanjut jadi pendampingan hampir lima tahun — dan mengubah cara saya menilai pekerjaan sendiri.</p> <span class=\"open\">Baca studi kasus ↗</span> </a> </div> </section> <div class=\"marquee accent\" aria-hidden=\"true\"> <div class=\"marquee-track\"> <span>Strategi</span><span>Desain</span><span>Pengembangan</span><span>Konsultasi</span><span>Problem Solving</span><span>User Experience</span><span>Produk Digital</span> <span>Strategi</span><span>Desain</span><span>Pengembangan</span><span>Konsultasi</span><span>Problem Solving</span><span>User Experience</span><span>Produk Digital</span> </div> </div> <section class=\"cta-ink pad\"> <img class=\"bgimg\" src=\"/img/cta-bg.webp\" width=\"1440\" height=\"1024\" loading=\"lazy\" decoding=\"async\" alt=\"\" aria-hidden=\"true\"> <div class=\"wrap\" style=\"position:relative\"> <span class=\"eyebrow reveal\">// Mari Bicara</span> <h2 class=\"h2 reveal d1\" style=\"margin:24px 0 36px\">Punya masalah yang layak diselesaikan?</h2> <div class=\"reveal d2\"><a href=\"https://wa.me/6285927277560?text=Hi!%20Saya%20lihat%20portofolio%20Anda%20dan%20ingin%20diskusi%20proyek%20serupa...\" class=\"btn on-ink\" target=\"_blank\" rel=\"noopener\" data-wa=\"cta\" data-page=\"/portofolio.html\"> Konsultasi Gratis<span class=\"arr\">↗</span> </a></div> </div> </section>";
const extraSchema = [{"@type":"CollectionPage","@id":"https://mglportfolio.vercel.app/portofolio#collection","url":"https://mglportfolio.vercel.app/portofolio","name":"Portofolio — Manganju Glory Laurencius","description":"Kumpulan proyek website: WordPress, Wix Studio, dan aplikasi web.","inLanguage":"id-ID","isPartOf":{"@id":"https://mglportfolio.vercel.app/#website"},"author":{"@id":"https://mglportfolio.vercel.app/#person"},"mainEntity":{"@type":"ItemList","numberOfItems":16,"itemListElement":[{"@type":"ListItem","position":1,"name":"Eyelevel-id","url":"https://eyelevel-id.com/"},{"@type":"ListItem","position":2,"name":"AddedEducation","url":"https://www.addededucation.com/"},{"@type":"ListItem","position":3,"name":"Ipas Indonesia","url":"https://ipasindonesia.org/"},{"@type":"ListItem","position":4,"name":"Jakarta Feminist","url":"https://jakartafeminist.com/"},{"@type":"ListItem","position":5,"name":"Cari Layanan","url":"https://carilayanan.com/"},{"@type":"ListItem","position":6,"name":"The Arise Foundation","url":"https://www.thearisefoundation.com/"},{"@type":"ListItem","position":7,"name":"Project Nambo Udik","url":"https://www.projectnamboudik.com/"},{"@type":"ListItem","position":8,"name":"Support Space","url":"https://www.supportspace.online/"},{"@type":"ListItem","position":9,"name":"Nikhil Bohra","url":"https://www.nikhilbohra.com/"},{"@type":"ListItem","position":10,"name":"Farm Fresh Bites","url":"https://farmfreshbites.wixstudio.com/farm-fresh-bites"},{"@type":"ListItem","position":11,"name":"Credit Health","url":"https://credithealth.vercel.app/"},{"@type":"ListItem","position":12,"name":"Spotless Web App","url":"https://dashboard-gilt-six-hkvkubuygh.vercel.app/"},{"@type":"ListItem","position":13,"name":"Spotless Mobile App","url":"https://app-eight-phi-12.vercel.app/"},{"@type":"ListItem","position":14,"name":"Spotless POS","url":"https://dashboard-gilt-six-hkvkubuygh.vercel.app/"},{"@type":"ListItem","position":15,"name":"Nusantara Rent","url":"https://indycar-fleet-hub.lovable.app/"},{"@type":"ListItem","position":16,"name":"Rasalokal","url":"https://rasa-lokal-sentuh-asia.lovable.app/"}]}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Beranda","item":"https://mglportfolio.vercel.app/"},{"@type":"ListItem","position":2,"name":"Portofolio","item":"https://mglportfolio.vercel.app/portofolio"}]}];
