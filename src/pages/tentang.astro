---
import Base from '../layouts/Base.astro';
import AboutBody from '../components/AboutBody.astro';
import seo from '../data/seo/about.json';

const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://mglportfolio.vercel.app/' },
    { '@type': 'ListItem', position: 2, name: 'Tentang', item: 'https://mglportfolio.vercel.app/tentang' },
  ],
};
---

<Base
  lang="id"
  title={seo.title_id}
  description={seo.desc_id}
  image={seo.ogImage}
  idPath="/tentang"
  enPath="/en/about"
  extraSchema={[breadcrumb]}
>
  <AboutBody lang="id" />
</Base>
