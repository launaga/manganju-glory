import Base from '../../layouts/Base.astro';
const body = "<section class=\"hero wrap\"> <div class=\"shead reveal\"> <div class=\"label\"><span class=\"eyebrow\">// Studi Kasus</span><span class=\"folio\">01</span></div> </div> <h1 class=\"h1 reveal d1\" style=\"max-width:20ch;margin-top:18px;font-size:clamp(32px,4.4vw,58px)\">Kenapa Website NGO Ini Gagal di Dua Agensi Sebelumnya</h1> <p class=\"lead reveal d2\" style=\"margin-top:22px\">Sebuah NGO ternama di London sudah membakar anggaran di dua agensi. Keduanya menghasilkan situs yang indah. Tidak satu pun bekerja.</p>  <div class=\"deflist reveal d3\" style=\"margin-top:34px\"> <div><b>Klien</b><p>NGO ternama di London. Namanya tidak disebut atas pertimbangan kerahasiaan.</p></div><div><b>Industri</b><p>Nirlaba / advokasi</p></div><div><b>Situasi awal</b><p>Dua agensi, dua situs, anggaran habis, hasil nol</p></div><div><b>Peran saya</b><p>Diagnosis, strategi, desain ulang, pengembangan</p></div> </div> </section> <hr class=\"hair\" style=\"margin:0 var(--gut)\"> <section class=\"pad-sm wrap\"> <div class=\"shead reveal\"> <div class=\"label\"><span class=\"eyebrow\">// 02 — Konteks</span></div> </div> <div class=\"persp\"> <div class=\"reveal\"><p class=\"big\">Dua agensi. Dua situs indah. Nol hasil.</p></div> <div class=\"reveal d1\"> <p class=\"lead\" style=\"margin-bottom:20px\">Saat mereka menghubungi saya, situsnya sudah dibangun ulang dua kali. Keduanya oleh agensi yang kompeten. Keduanya menghasilkan sesuatu yang enak dilihat — layout bersih, animasi yang halus, mockup yang rapi di setiap breakpoint.</p><p class=\"lead\" style=\"margin-bottom:20px\">Dan keduanya tidak bekerja. Yang menarik bukan kegagalannya, tapi bahwa tidak ada yang bisa menjelaskan kenapa. Semua orang di dalam ruangan itu sepakat situsnya bagus. Itu justru bagian yang paling membingungkan buat mereka.</p> </div> </div> </section><section class=\"pad-sm wrap\"> <div class=\"shead reveal\"> <div class=\"label\"><span class=\"eyebrow\">// 03 — Masalah sebenarnya</span></div> </div> <div class=\"persp\"> <div class=\"reveal\"><p class=\"big\">Tidak ada yang bertanya siapa yang berkunjung.</p></div> <div class=\"reveal d1\"> <p class=\"lead\" style=\"margin-bottom:20px\">Saya membaca ulang brief kedua agensi itu. Keduanya berisi hal yang sama: struktur halaman, referensi visual, dan daftar fitur. Tidak satu pun berisi jawaban atas tiga pertanyaan dasar — siapa sebenarnya yang datang ke situs ini, kenapa mereka pergi, dan apa yang organisasi ini butuhkan dari mereka.</p><p class=\"lead\" style=\"margin-bottom:20px\">Tanpa jawaban itu, satu-satunya kriteria yang tersisa untuk menilai desain adalah selera. Dan kalau kriterianya selera, yang menang adalah selera orang yang paling senior di ruangan — bukan kebutuhan orang yang benar-benar akan memakai situsnya.</p><p class=\"lead\" style=\"margin-bottom:20px\">Itu sebabnya dua situs berturut-turut bisa &quot;berhasil&quot; di presentasi dan gagal di dunia nyata. Keduanya dibangun untuk membanggakan pendirinya, bukan untuk menjawab kecemasan pengunjungnya.</p> </div> </div> </section><section class=\"pad-sm wrap\"> <div class=\"shead reveal\"> <div class=\"label\"><span class=\"eyebrow\">// 04 — Pendekatan</span></div> </div> <div class=\"persp\"> <div class=\"reveal\"><p class=\"big\">Mulai dari kecemasan pengunjung, bukan kebanggaan pendiri.</p></div> <div class=\"reveal d1\"> <p class=\"lead\" style=\"margin-bottom:20px\">Saya membangun ulang dengan urutan yang terbalik. Bukan dari struktur halaman, tapi dari daftar keberatan: apa yang membuat seseorang ragu di detik kedelapan, dan apa yang dia butuhkan untuk melewatinya.</p><p class=\"lead\" style=\"margin-bottom:20px\">Trade-off yang paling sering ditentang: saya justru menambah friksi di beberapa tempat. Ada langkah yang sengaja diperlambat, karena pengunjung yang mengambil keputusan terlalu cepat di situ akan menyesal dan pergi. Dan saya menghapus friksi di tempat lain yang selama ini dianggap penting oleh tim internal, tapi hanya penting buat mereka.</p><p class=\"lead\" style=\"margin-bottom:20px\">Itu keputusan yang tidak nyaman. Menambah langkah terdengar seperti kesalahan buat siapa pun yang pernah membaca artikel tentang optimasi konversi. Tapi friksi bukan musuh — friksi di tempat yang salah yang jadi musuh.</p> </div> </div> </section> <hr class=\"hair\" style=\"margin:0 var(--gut)\"> <section class=\"pad-sm wrap\"> <div class=\"shead reveal\"> <div class=\"label\"> <div> <span class=\"eyebrow\">// 05 — Hasil</span> <h2 class=\"h2\" style=\"margin-top:18px\">Yang bisa saya pertanggungjawabkan.</h2> </div> <span class=\"folio\">05</span> </div> </div> <div class=\"stats reveal\"> <div class=\"stat\"><div class=\"num\" style=\"font-size:clamp(26px,2.6vw,38px)\">Konversi naik 2×</div><p style=\"margin-top:10px\">Dalam enam minggu setelah peluncuran.</p></div><div class=\"stat\"><div class=\"num\" style=\"font-size:clamp(26px,2.6vw,38px)\">Nol agensi ketiga</div><p style=\"margin-top:10px\">Situsnya tidak perlu dibangun ulang lagi setelah itu.</p></div> </div> <p class=\"lead\" style=\"margin-top:28px;font-size:15px;color:var(--ink-soft);max-width:70ch\">Angka konversi di atas adalah yang dilaporkan klien dalam enam minggu pertama. Metrik lain tidak saya cantumkan karena saya tidak memegang datanya — dan angka yang tidak bisa saya pertanggungjawabkan lebih baik tidak ditulis.</p> </section> <section class=\"pad-sm wrap\"> <div class=\"reveal\" style=\"display:flex;gap:14px;flex-wrap:wrap\"> <a href=\"/layanan/pendampingan-website\" class=\"btn ghost\">Pendampingan &amp; konsultasi website <span class=\"arr\">↗</span></a>  <a href=\"/portofolio\" class=\"btn ghost\">Semua proyek <span class=\"arr\">↗</span></a> </div> </section> <section class=\"cta-ink pad\"> <img class=\"bgimg\" src=\"/img/cta-bg.webp\" width=\"1440\" height=\"1024\" loading=\"lazy\" decoding=\"async\" alt=\"\" aria-hidden=\"true\"> <div class=\"wrap\" style=\"position:relative\"> <span class=\"eyebrow reveal\">// Mari Bicara</span> <h2 class=\"h2 reveal d1\" style=\"margin:24px 0 36px;max-width:20ch\">Punya masalah yang layak diselesaikan?</h2> <div class=\"reveal d2\"> <a href=\"https://wa.me/6285927277560?text=Hi!%20Saya%20baca%20studi%20kasus%20NGO%20London%20dan%20situasi%20saya%20mirip...\" class=\"btn on-ink\" target=\"_blank\" rel=\"noopener\" data-wa=\"cta\" data-page=\"/portofolio/redesign-website-ngo-london.html\"> Konsultasi Gratis<span class=\"arr\">↗</span> </a> </div> </div> </section>";
const extraSchema = [{"@type":"Article","@id":"https://mglportfolio.vercel.app/portofolio/redesign-website-ngo-london#article","headline":"Kenapa Website NGO Ini Gagal di Dua Agensi Sebelumnya","description":"Dua agensi menghasilkan situs yang indah dan tetap gagal. Yang berubah bukan desainnya, tapi pertanyaan yang diajukan di awal.","url":"https://mglportfolio.vercel.app/portofolio/redesign-website-ngo-london","datePublished":"2026-07-17","inLanguage":"id-ID","author":{"@id":"https://mglportfolio.vercel.app/#person"},"publisher":{"@id":"https://mglportfolio.vercel.app/#person"},"isPartOf":{"@id":"https://mglportfolio.vercel.app/#website"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Beranda","item":"https://mglportfolio.vercel.app/"},{"@type":"ListItem","position":2,"name":"Portofolio","item":"https://mglportfolio.vercel.app/portofolio"},{"@type":"ListItem","position":3,"name":"Redesign Website NGO London","item":"https://mglportfolio.vercel.app/portofolio/redesign-website-ngo-london"}]}];
