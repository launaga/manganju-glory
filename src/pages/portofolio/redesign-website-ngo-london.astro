<Base lang="id" title="Studi Kasus: Redesign Website NGO London | MGL" description="Dua agensi menghasilkan situs yang indah dan tetap gagal. Yang berubah bukan desainnya, tapi pertanyaan yang diajukan di awal." idPath="/portofolio/redesign-website-ngo-london" enPath="/en/work/redesign-website-ngo-london" extraSchema={extraSchema}>
