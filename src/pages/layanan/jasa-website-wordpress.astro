import Base from '../../layouts/Base.astro';
const body = "<section class=\"hero wrap\"> <div class=\"shead reveal\"> <div class=\"label\"><span class=\"eyebrow\">// Layanan</span><span class=\"folio\">01</span></div> </div> <h1 class=\"h1 reveal d1\" style=\"max-width:22ch;margin-top:18px;font-size:clamp(32px,4.4vw,60px)\">Jasa Website WordPress — Dibangun untuk Anda Miliki, Bukan Anda Sewa</h1> <p class=\"lead reveal d2\" style=\"margin-top:22px\">WordPress yang ditata rapi sejak awal: bisa Anda kelola sendiri, cepat dimuat, dan tidak menyandera Anda ke siapa pun.</p> <div class=\"reveal d3\" style=\"margin-top:32px;display:flex;gap:14px;flex-wrap:wrap\"> <a href=\"https://wa.me/6285927277560?text=Hi!%20Saya%20tertarik%20dengan%20jasa%20website%20WordPress...\" class=\"btn\" target=\"_blank\" rel=\"noopener\" data-wa=\"hero\" data-page=\"/layanan/jasa-website-wordpress.html\"> Konsultasi Gratis<span class=\"arr\">↗</span> </a> <a href=\"/harga\" class=\"btn ghost\">Lihat harga <span class=\"arr\">↗</span></a> </div> </section> <hr class=\"hair\" style=\"margin:0 var(--gut)\">  <section class=\"pad-sm wrap\"> <div class=\"shead reveal\"> <div class=\"label\"><span class=\"eyebrow\">// 02 — Masalahnya</span><span class=\"folio\">02</span></div> </div> <div class=\"persp\"> <div class=\"reveal\"> <p class=\"big\">WordPress tidak lambat. Cara orang membangunnya yang lambat.</p> </div> <div class=\"reveal d1\"> <p class=\"lead\" style=\"margin-bottom:20px\">Reputasi buruk WordPress hampir selalu berasal dari cara ia dipasang, bukan dari platformnya. Tema serbaguna yang membawa dua puluh fitur yang tidak Anda pakai, sepuluh plugin yang tumpang tindih, page builder yang menghasilkan markup berlapis-lapis — lalu semua orang menyimpulkan &quot;WordPress berat&quot;.</p><p class=\"lead\" style=\"margin-bottom:20px\">Ada masalah kedua yang lebih jarang dibicarakan: kepemilikan. Banyak situs WordPress dibangun di atas tema berbayar dengan lisensi atas nama agensinya, plugin premium yang menempel di akun orang lain, dan hosting yang tidak bisa Anda akses. Situsnya milik Anda di atas kertas, tapi Anda tidak bisa pindah tanpa membangun ulang.</p><p class=\"lead\" style=\"margin-bottom:20px\">Saya membangun WordPress dengan asumsi sebaliknya: suatu hari Anda mungkin ingin pindah ke orang lain, dan itu harus mungkin. Lisensi atas nama Anda, akses atas nama Anda, plugin sesedikit mungkin, dan struktur yang bisa dibaca developer berikutnya tanpa harus menelepon saya.</p> </div> </div> </section> <hr class=\"hair\" style=\"margin:0 var(--gut)\">  <section class=\"pad-sm wrap\"> <div class=\"shead reveal\"> <div class=\"label\"> <div> <span class=\"eyebrow\">// 03 — Yang termasuk</span> <h2 class=\"h2\" style=\"margin-top:18px;max-width:20ch\">Apa yang benar-benar Anda dapat.</h2> </div> <span class=\"folio\">03</span> </div> </div> <div class=\"deflist reveal\"> <div><b>Setup bersih</b><p>Tanpa tema serbaguna, tanpa plugin yang tumpang tindih. Hanya yang benar-benar dipakai.</p></div><div><b>Struktur konten</b><p>Custom post type dan field yang sesuai isi Anda, supaya menambah konten terasa jelas, bukan menebak-nebak.</p></div><div><b>Optimasi performa</b><p>Gambar, caching, dan pemuatan aset ditangani sejak awal — bukan ditambal dengan plugin di akhir.</p></div><div><b>SEO teknis</b><p>Struktur heading, schema, sitemap, dan URL yang benar dari hari pertama.</p></div><div><b>Kepemilikan penuh</b><p>Domain, hosting, dan lisensi atas nama Anda. Saya bantu setup, tapi akunnya milik Anda.</p></div><div><b>Training &amp; dokumentasi</b><p>Rekaman sesi dan catatan singkat, supaya siapa pun yang mengurus situs setelah ini punya pegangan.</p></div> </div> </section>  <section class=\"pad-sm wrap\"> <div class=\"shead reveal\"> <div class=\"label\"> <div> <span class=\"eyebrow\">// 04 — Kecocokan</span> <h2 class=\"h2\" style=\"margin-top:18px;max-width:22ch\">Cocok untuk siapa — dan untuk siapa tidak.</h2> <p class=\"lead\" style=\"margin-top:16px;max-width:62ch\">Kolom kanan sama pentingnya dengan kolom kiri. Saya lebih suka kehilangan proyek di tahap ini daripada kita berdua menyadarinya di minggu kelima.</p> </div> <span class=\"folio\">04</span> </div> </div> <div class=\"fit-grid reveal\"> <div class=\"fit yes\"> <b>Cocok kalau</b> <ul><li>Bisnis dan organisasi yang ingin memiliki penuh aset digitalnya.</li><li>Situs yang kontennya akan terus bertambah — artikel, program, publikasi, katalog.</li><li>Tim yang ingin mengurus kontennya sendiri tanpa developer.</li><li>Situs WordPress yang sudah ada tapi jadi lambat dan menakutkan untuk disentuh.</li></ul> </div> <div class=\"fit no\"> <b>Tidak cocok kalau</b> <ul><li>Yang Anda butuhkan cuma satu halaman. WordPress berlebihan untuk itu.</li><li>Anda ingin tetap pakai tema serbaguna yang sekarang. Kalau itu syaratnya, saya bukan orang yang tepat.</li><li>Tidak ada yang akan memperbarui apa pun setelah peluncuran. WordPress butuh perawatan ringan tapi rutin.</li><li>Anda mencari harga termurah untuk memasang tema jadi. Itu pekerjaan lain, dan ada yang mengerjakannya lebih murah dari saya.</li></ul> </div> </div> </section> <hr class=\"hair\" style=\"margin:0 var(--gut)\">  <section class=\"pad-sm wrap\"> <div class=\"shead reveal\"> <div class=\"label\"> <div> <span class=\"eyebrow\">// 05 — Proses</span> <h2 class=\"h2\" style=\"margin-top:18px\">Bagaimana ini berjalan.</h2> <p class=\"lead\" style=\"margin-top:16px;max-width:62ch\">3–6 minggu untuk situs baru. Redesign dengan migrasi konten biasanya lebih lama, tergantung banyaknya halaman lama.</p> </div> <span class=\"folio\">05</span> </div> </div> <div class=\"proc\"> <div class=\"proc-step reveal\"><div class=\"pn\">1.</div><h3>Audit atau discovery</h3><p>Kalau sudah ada situs: apa yang bisa diselamatkan, apa yang harus dibuang. Kalau belum: struktur konten dulu.</p></div><div class=\"proc-step reveal\"><div class=\"pn\">2.</div><h3>Struktur &amp; desain</h3><p>Model konten dan hierarki halaman disepakati sebelum tampilan dikerjakan.</p></div><div class=\"proc-step reveal\"><div class=\"pn\">3.</div><h3>Bangun &amp; migrasi</h3><p>Pengembangan tema, migrasi konten, dan pengaturan redirect kalau URL-nya berubah — supaya peringkat yang sudah ada tidak hangus.</p></div><div class=\"proc-step reveal\"><div class=\"pn\">4.</div><h3>Luncurkan &amp; serahkan</h3><p>Akses, lisensi, dan dokumentasi diserahkan sepenuhnya ke tangan Anda.</p></div> </div> </section>  <section class=\"pad-sm wrap\"> <div class=\"shead reveal\"> <div class=\"label\"> <div> <span class=\"eyebrow\">// 06 — Harga</span> <h2 class=\"h2\" style=\"margin-top:18px\">Mulai Rp5.000.000</h2> <p class=\"lead\" style=\"margin-top:16px;max-width:62ch\">Bergantung pada jumlah halaman, kerumitan struktur konten, dan apakah ada migrasi dari situs lama.</p> <div style=\"margin-top:26px\"><a href=\"/harga\" class=\"btn ghost\">Lihat rincian harga &amp; yang tidak termasuk <span class=\"arr\">↗</span></a></div> </div> <span class=\"folio\">06</span> </div> </div> </section>  <section class=\"pad-sm wrap\"> <div class=\"shead reveal\"> <div class=\"label\"> <div> <span class=\"eyebrow\">// 07 — Contoh</span> <h2 class=\"h2\" style=\"margin-top:18px\">Pekerjaan serupa.</h2> </div> <span class=\"folio\">07</span> </div> </div> <div class=\"more-grid reveal\"> <a class=\"more-card\" href=\"https://jakartafeminist.com/\" target=\"_blank\" rel=\"noopener noreferrer\"> <div class=\"mthumb\"><img src=\"/img/work/jakarta-feminist.webp\" alt=\"Tangkapan layar proyek Jakarta Feminist\" width=\"1200\" height=\"579\" loading=\"lazy\" decoding=\"async\"></div> <div class=\"mt\"><h3 class=\"h3\">Jakarta Feminist</h3><span class=\"mtag\">.Redesign .WordPress</span></div> <p>Organisasi feminis yang memperkuat advokasi. Saya satukan konten editorial, acara, dan sumber daya menjadi satu pusat mobilisasi — migrasi dari Wix Editor ke WordPress, menopang Women&#39;s March Jakarta, FemFest, dan lainnya.</p> <span class=\"open\">Lihat situs ↗</span> </a><a class=\"more-card\" href=\"https://ipasindonesia.org/\" target=\"_blank\" rel=\"noopener noreferrer\"> <div class=\"mthumb\"><img src=\"/img/work/ipas-indonesia.webp\" alt=\"Tangkapan layar proyek Ipas Indonesia\" width=\"947\" height=\"857\" loading=\"lazy\" decoding=\"async\"></div> <div class=\"mt\"><h3 class=\"h3\">Ipas Indonesia</h3><span class=\"mtag\">.Redesign .WordPress</span></div> <p>NGO kesehatan reproduksi yang memperluas akses layanan pascakeguguran yang aman. Situs lama mereka menyimpang dari design system internasional yang baru. Saya bangun ulang agar selaras dengan brand global, tanpa mengorbankan preferensi audiens Indonesia.</p> <span class=\"open\">Lihat situs ↗</span> </a><a class=\"more-card\" href=\"https://carilayanan.com/\" target=\"_blank\" rel=\"noopener noreferrer\"> <div class=\"mthumb\"><img src=\"/img/work/cari-layanan.webp\" alt=\"Tangkapan layar proyek Cari Layanan\" width=\"861\" height=\"822\" loading=\"lazy\" decoding=\"async\"></div> <div class=\"mt\"><h3 class=\"h3\">Cari Layanan</h3><span class=\"mtag\">.WordPress</span></div> <p>Direktori krisis untuk penyintas kekerasan berbasis gender selama COVID-19. Saya bangun direktori WordPress yang memetakan layanan terverifikasi berdasarkan lokasi dan kebutuhan — rahasia, langsung bisa diakses, dan menskala hingga ribuan pengguna.</p> <span class=\"open\">Lihat situs ↗</span> </a> </div> <p class=\"lead\" style=\"margin-top:24px;font-size:15px\"> <a href=\"/portofolio\" style=\"text-decoration:underline;text-underline-offset:4px\">Lihat seluruh portofolio website</a> — lengkap dengan konteks di balik setiap keputusannya.\n</p> </section> <hr class=\"hair\" style=\"margin:0 var(--gut)\">  <section class=\"pad-sm wrap\"> <div class=\"shead reveal\"> <div class=\"label\"> <div> <span class=\"eyebrow\">// 08 — Pertanyaan</span> <h2 class=\"h2\" style=\"margin-top:18px\">Yang biasanya ditanyakan.</h2> </div> <span class=\"folio\">08</span> </div> </div> <div class=\"faq reveal\"> <details> <summary><span class=\"fq\">/01</span>Apakah bisa migrasi dari Wix atau platform lain?</summary> <p class=\"fa\">Bisa, dan saya sudah melakukannya — Jakarta Feminist adalah migrasi dari Wix Editor ke WordPress. Bagian yang paling menentukan bukan memindahkan kontennya, tapi memetakan URL lama ke URL baru dengan redirect yang benar. Dilewatkan, dan peringkat yang Anda bangun bertahun-tahun bisa hilang dalam semalam.</p> </details><details> <summary><span class=\"fq\">/02</span>Pakai Elementor atau tidak?</summary> <p class=\"fa\">Kalau tim Anda perlu menyusun halaman baru sendiri secara berkala, Elementor masuk akal dan saya bangun dengan itu. Kalau yang Anda ubah hanya teks dan gambar di struktur yang sudah ada, page builder cuma menambah berat tanpa memberi manfaat. Ini keputusan yang diambil berdasarkan cara kerja tim Anda, bukan preferensi saya.</p> </details><details> <summary><span class=\"fq\">/03</span>Siapa yang mengurus update dan keamanan setelah peluncuran?</summary> <p class=\"fa\">Secara bawaan, Anda — dan saya tunjukkan caranya saat serah terima. Kalau tidak ada yang mau memegangnya, itu masuk ke layanan pendampingan jangka panjang. Yang tidak saya sarankan adalah membiarkan tidak ada yang mengurusnya sama sekali; situs WordPress yang tidak pernah diperbarui akan jadi masalah keamanan, bukan mungkin.</p> </details><details> <summary><span class=\"fq\">/04</span>Kalau saya mau pindah ke developer lain nanti?</summary> <p class=\"fa\">Bisa, tanpa perlu izin dari saya. Domain, hosting, dan lisensi sudah atas nama Anda sejak awal, dan strukturnya sengaja dibuat agar bisa dibaca orang lain. Situs yang hanya bisa disentuh pembuatnya bukan aset — itu jebakan, dan saya tidak membangun seperti itu.</p> </details> </div> </section>  <section class=\"cta-ink pad\"> <img class=\"bgimg\" src=\"/img/cta-bg.webp\" width=\"1440\" height=\"1024\" loading=\"lazy\" decoding=\"async\" alt=\"\" aria-hidden=\"true\"> <div class=\"wrap\" style=\"position:relative\"> <span class=\"eyebrow reveal\">// Mari Bicara</span> <h2 class=\"h2 reveal d1\" style=\"margin:24px 0 36px;max-width:20ch\">Kedengarannya cocok? Mari kita uji dulu.</h2> <div class=\"reveal d2\"> <a href=\"https://wa.me/6285927277560?text=Hi!%20Saya%20tertarik%20dengan%20jasa%20website%20WordPress...\" class=\"btn on-ink\" target=\"_blank\" rel=\"noopener\" data-wa=\"cta\" data-page=\"/layanan/jasa-website-wordpress.html\"> Konsultasi Gratis<span class=\"arr\">↗</span> </a> </div> </div> </section>";
const extraSchema = [{"@type":"Service","name":"jasa website wordpress","description":"Jasa website WordPress untuk bisnis dan organisasi: dibangun untuk kepemilikan penuh, mudah dikelola, dan siap bertumbuh.","url":"https://mglportfolio.vercel.app/layanan/jasa-website-wordpress","serviceType":"Website WordPress","provider":{"@id":"https://mglportfolio.vercel.app/#service"},"areaServed":{"@type":"Country","name":"Indonesia"},"inLanguage":"id-ID"},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Beranda","item":"https://mglportfolio.vercel.app/"},{"@type":"ListItem","position":2,"name":"Layanan","item":"https://mglportfolio.vercel.app/layanan"},{"@type":"ListItem","position":3,"name":"Website WordPress","item":"https://mglportfolio.vercel.app/layanan/jasa-website-wordpress"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Apakah bisa migrasi dari Wix atau platform lain?","acceptedAnswer":{"@type":"Answer","text":"Bisa, dan saya sudah melakukannya — Jakarta Feminist adalah migrasi dari Wix Editor ke WordPress. Bagian yang paling menentukan bukan memindahkan kontennya, tapi memetakan URL lama ke URL baru dengan redirect yang benar. Dilewatkan, dan peringkat yang Anda bangun bertahun-tahun bisa hilang dalam semalam."}},{"@type":"Question","name":"Pakai Elementor atau tidak?","acceptedAnswer":{"@type":"Answer","text":"Kalau tim Anda perlu menyusun halaman baru sendiri secara berkala, Elementor masuk akal dan saya bangun dengan itu. Kalau yang Anda ubah hanya teks dan gambar di struktur yang sudah ada, page builder cuma menambah berat tanpa memberi manfaat. Ini keputusan yang diambil berdasarkan cara kerja tim Anda, bukan preferensi saya."}},{"@type":"Question","name":"Siapa yang mengurus update dan keamanan setelah peluncuran?","acceptedAnswer":{"@type":"Answer","text":"Secara bawaan, Anda — dan saya tunjukkan caranya saat serah terima. Kalau tidak ada yang mau memegangnya, itu masuk ke layanan pendampingan jangka panjang. Yang tidak saya sarankan adalah membiarkan tidak ada yang mengurusnya sama sekali; situs WordPress yang tidak pernah diperbarui akan jadi masalah keamanan, bukan mungkin."}},{"@type":"Question","name":"Kalau saya mau pindah ke developer lain nanti?","acceptedAnswer":{"@type":"Answer","text":"Bisa, tanpa perlu izin dari saya. Domain, hosting, dan lisensi sudah atas nama Anda sejak awal, dan strukturnya sengaja dibuat agar bisa dibaca orang lain. Situs yang hanya bisa disentuh pembuatnya bukan aset — itu jebakan, dan saya tidak membangun seperti itu."}}]}];
