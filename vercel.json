{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/", "destination": "https://haloglory.com/", "permanent": true },
    { "source": "/:path*", "destination": "https://haloglory.com/:path*", "permanent": true }
  ]
}
