# Origin situs. SATU-SATUNYA tempat domain didefinisikan.
# Pindah domain = ganti nilai ini di hosting, lalu redeploy. Nol perubahan kode.
# Lihat MIGRATION.md.
PUBLIC_SITE_URL="https://mglportfolio.vercel.app"

# GA4. Kosongkan untuk mematikan GA4 sepenuhnya (nol script pihak ketiga).
# Hanya aktif di production build.
PUBLIC_GA4_ID=""

# ── Supabase (CMS/admin) ──────────────────────────────────────────────────
# CLIENT-SAFE. Keduanya di-inline ke bundle browser; aman karena RLS yang
# menegakkan keamanan. Ambil dari Supabase → Project Settings → API.
PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# NOTE: service_role key TIDAK PERNAH diletakkan di sini atau di kode client.
# Ia hanya dipakai server-side (GitHub Action / Edge Function) via secret.
